@{
    Layout = "_AdminLayout";
    NopHtml.SetActiveMenuItemSystemName("TwinParticles.CheckEngine.AiDashboard");
    ViewBag.PageTitle = T("Plugins.TwinParticles.CheckEngine.Ai.Dashboard").Text;
}
@await Html.PartialAsync("~/Plugins/TwinParticles.CheckEngine/Views/Shared/_CheckEngineAdminAssets.cshtml")

<div class="content-header clearfix">
    <h1 class="float-left">@T("Plugins.TwinParticles.CheckEngine.Ai.Dashboard")</h1>
    <div class="float-right">
        <a class="btn btn-secondary" href="@Url.Action("Dashboard", "CheckEngine")">@T("Plugins.TwinParticles.CheckEngine.Dashboard")</a>
        <a class="btn btn-info" href="@Url.Action("ReviewBoard", "AiAdmin")">@T("Plugins.TwinParticles.CheckEngine.Ai.Review")</a>
        <a class="btn btn-primary" href="@Url.Action("Configure", "CheckEngine")">@T("Plugins.TwinParticles.CheckEngine.Configuration")</a>
    </div>
</div>

<section class="content ce-marketplace-admin">
    <div class="container-fluid">
        @Html.AntiForgeryToken()
        <script type="application/json" data-ce-i18n>@Html.Raw(System.Text.Json.JsonSerializer.Serialize(new {
            disclosureAck = T("Plugins.TwinParticles.CheckEngine.Ai.Review.DisclosureAck").Text,
            disclosurePending = T("Plugins.TwinParticles.CheckEngine.Ai.Review.DisclosurePending").Text,
            globalToday = T("Plugins.TwinParticles.CheckEngine.Ai.Dashboard.GlobalToday").Text,
            pending = T("Plugins.TwinParticles.CheckEngine.Ai.Dashboard.Pending").Text,
            budgetAlerts = T("Plugins.TwinParticles.CheckEngine.Ai.Dashboard.BudgetAlerts").Text,
            budgetAlertItem = T("Plugins.TwinParticles.CheckEngine.Ai.Dashboard.BudgetAlertItem").Text,
            budgetGlobal = T("Plugins.TwinParticles.CheckEngine.Ai.Dashboard.BudgetGlobal").Text,
            ackFailed = T("Plugins.TwinParticles.CheckEngine.Ai.Review.AckFailed").Text
        }))</script>
        <div class="ce-mp-alert ce-mp-alert--info" data-ce-admin-alert hidden role="status"></div>
        <div class="card card-default">
            <div class="card-header">
                <h3 class="card-title">@T("Plugins.TwinParticles.CheckEngine.Ai.Dashboard.Usage")</h3>
            </div>
            <div class="card-body">
                <p id="ce-ai-disclosure-status" class="text-muted"></p>
                <p id="ce-ai-global-usage" class="text-muted"></p>
                <div class="table-responsive">
                    <table class="table table-bordered" id="ce-ai-usage-table">
                        <thead>
                            <tr>
                                <th>@T("Plugins.TwinParticles.CheckEngine.Common.Col.Feature")</th>
                                <th>@T("Plugins.TwinParticles.CheckEngine.Ai.Dashboard.Col.TodayTokens")</th>
                                <th>@T("Plugins.TwinParticles.CheckEngine.Ai.Dashboard.Col.TodayCost")</th>
                                <th>@T("Plugins.TwinParticles.CheckEngine.Ai.Dashboard.Col.Tokens7d")</th>
                                <th>@T("Plugins.TwinParticles.CheckEngine.Ai.Dashboard.Col.Tokens30d")</th>
                                <th>@T("Plugins.TwinParticles.CheckEngine.Ai.Dashboard.Col.Ceiling")</th>
                                <th>@T("Plugins.TwinParticles.CheckEngine.Ai.Dashboard.Col.TodayUtil")</th>
                                <th>@T("Plugins.TwinParticles.CheckEngine.Ai.Dashboard.Col.Fail7d")</th>
                                <th>@T("Plugins.TwinParticles.CheckEngine.Ai.Dashboard.Col.Fail30d")</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
                <div id="ce-ai-alerts" class="alert alert-warning mt-3" hidden></div>
                <p id="ce-ai-pending-count" class="mt-3"></p>
                <button id="ce-ai-ack-disclosure" type="button" class="btn btn-warning">@T("Plugins.TwinParticles.CheckEngine.Ai.AcknowledgeDisclosure")</button>
            </div>
        </div>
    </div>
</section>

<script>
(function () {
  var token = document.querySelector('input[name="__RequestVerificationToken"]');
  var i18n = (window.CheckEngineAdmin && CheckEngineAdmin.readI18n)
    ? CheckEngineAdmin.readI18n(document)
    : {};
  function fmt() {
    return (window.CheckEngineAdmin && CheckEngineAdmin.format)
      ? CheckEngineAdmin.format.apply(null, arguments)
      : String(arguments[0] || '');
  }
  function headers(json) {
    var h = { 'Accept': 'application/json' };
    if (json) h['Content-Type'] = 'application/json';
    if (token && token.value) h['RequestVerificationToken'] = token.value;
    return h;
  }
  function errorMessage(err, fallback) {
    return (window.CheckEngineAdmin && CheckEngineAdmin.errorMessage)
      ? CheckEngineAdmin.errorMessage(err, fallback)
      : (fallback || 'Request failed.');
  }
  function showAlert(kind, message) {
    var el = document.querySelector('[data-ce-admin-alert]');
    if (!el) return;
    el.hidden = !message;
    el.textContent = message || '';
    el.className = 'ce-mp-alert ce-mp-alert--' + (kind || 'info');
  }
  function pct(usage, ceiling) {
    if (!ceiling) return '—';
    return Math.min(100, Math.round((usage / ceiling) * 100)) + '%';
  }
  function rate(fraction) {
    if (fraction == null || isNaN(fraction)) return '—';
    return Math.round(fraction * 1000) / 10 + '%';
  }
  function money(value) {
    if (value == null || isNaN(value)) return '—';
    return '$' + (Math.round(value * 10000) / 10000);
  }
  function render(data) {
    document.getElementById('ce-ai-disclosure-status').textContent =
      data.disclosureAcknowledged
        ? (i18n.disclosureAck || 'Disclosure acknowledged.')
        : (i18n.disclosurePending || 'Disclosure not acknowledged — AI features remain gated.');
    document.getElementById('ce-ai-global-usage').textContent = fmt(
      i18n.globalToday || 'Global today: {0} / {1} tokens · rate ${2} / 1K tokens',
      data.globalDailyUsage || 0,
      data.globalDailyCeiling || 0,
      data.tokenCostPer1KUsd || 0);
    var tbody = document.querySelector('#ce-ai-usage-table tbody');
    tbody.innerHTML = '';
    (data.usage || []).forEach(function (row) {
      var summary = row.summary || {};
      var tr = document.createElement('tr');
      tr.innerHTML =
        '<td><code>' + row.featureKey + '</code></td>' +
        '<td>' + (summary.todayTokens || row.dailyUsage || 0) + '</td>' +
        '<td>' + money(row.todayEstimatedCostUsd ?? summary.todayEstimatedCostUsd) + '</td>' +
        '<td>' + (summary.last7DaysTokens || 0) + '</td>' +
        '<td>' + (summary.last30DaysTokens || 0) + '</td>' +
        '<td>' + row.dailyCeiling + '</td>' +
        '<td>' + pct(summary.todayTokens || row.dailyUsage || 0, row.dailyCeiling) + '</td>' +
        '<td>' + rate(row.last7DaysFailureRate) + '</td>' +
        '<td>' + rate(row.last30DaysFailureRate) + '</td>';
      tbody.appendChild(tr);
    });
    document.getElementById('ce-ai-pending-count').textContent = fmt(
      i18n.pending || 'Pending content candidates: {0} · Pending fitment AI proposals: {1}',
      data.pendingContentCount || 0,
      data.pendingFitmentAiCount || 0);
    var alerts = document.getElementById('ce-ai-alerts');
    var recent = data.recentBudgetAlerts || [];
    if (recent.length) {
      alerts.hidden = false;
      alerts.innerHTML = '<strong>' + (i18n.budgetAlerts || 'Budget alerts today') + '</strong><ul>' + recent.map(function (alert) {
        var scope = alert.global ? (i18n.budgetGlobal || 'global') : alert.featureKey;
        return '<li>' + fmt(i18n.budgetAlertItem || '{0}: {1} / {2} tokens', scope, alert.usage, alert.ceiling) + '</li>';
      }).join('') + '</ul>';
    } else {
      alerts.hidden = true;
      alerts.innerHTML = '';
    }
  }
  function load() {
    fetch('/Admin/CheckEngine/AiAdmin/DashboardData', { headers: headers(false) })
      .then(function (r) { return r.json(); })
      .then(render);
  }
  document.getElementById('ce-ai-ack-disclosure').addEventListener('click', function () {
    fetch('/Admin/CheckEngine/AiAdmin/AcknowledgeDisclosure', {
      method: 'POST',
      headers: headers(false),
      credentials: 'same-origin'
    }).then(function (r) {
      return r.json().then(function (body) { return { ok: r.ok, body: body }; }).catch(function () { return { ok: r.ok, body: {} }; });
    }).then(function (res) {
      if (!res.ok) {
        showAlert('error', errorMessage(res.body, i18n.ackFailed || 'Acknowledgement failed.'));
        return;
      }
      showAlert('success', i18n.disclosureAck || 'Disclosure acknowledged.');
      load();
    }).catch(function (err) {
      showAlert('error', errorMessage(err, i18n.ackFailed || 'Acknowledgement failed.'));
    });
  });
  load();
})();
</script>
