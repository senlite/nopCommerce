@{
    Layout = "_AdminLayout";
    NopHtml.SetActiveMenuItemSystemName("TwinParticles.CheckEngine");
    ViewBag.PageTitle = T("Plugins.TwinParticles.CheckEngine.Payout.Admin").Text;
}

<div class="content-header clearfix">
    <h1 class="float-left">@T("Plugins.TwinParticles.CheckEngine.Payout.Admin")</h1>
</div>

<section class="content">
    <div class="container-fluid">
        @Html.AntiForgeryToken()
        <div class="card card-default">
            <div class="card-body">
                <p class="text-muted">@T("Plugins.TwinParticles.CheckEngine.Payout.Admin.Hint")</p>
                <div class="form-inline mb-3">
                    <label class="mr-2">Vendor id</label>
                    <input id="ce-payout-vendor" class="form-control mr-2" type="number" value="1" />
                    <button id="ce-payout-list" type="button" class="btn btn-secondary mr-2">List</button>
                    <button id="ce-payout-generate" type="button" class="btn btn-primary">Generate (last 30 days)</button>
                </div>
                <div class="form-inline mb-3">
                    <label class="mr-2">Statement id</label>
                    <input id="ce-payout-statement" class="form-control mr-2" type="number" />
                    <button id="ce-payout-finalize" type="button" class="btn btn-secondary mr-1">Finalize</button>
                    <button id="ce-payout-push" type="button" class="btn btn-secondary mr-1">Push ERP</button>
                    <button id="ce-payout-reconcile" type="button" class="btn btn-secondary">Reconcile</button>
                </div>
                <pre id="ce-payout-result" style="white-space: pre-wrap;"></pre>
            </div>
        </div>
    </div>
</section>

<script>
(function () {
  var token = document.querySelector('input[name="__RequestVerificationToken"]');
  function headers(json) {
    var h = { 'Accept': 'application/json' };
    if (json) h['Content-Type'] = 'application/json';
    if (token && token.value) h['RequestVerificationToken'] = token.value;
    return h;
  }
  function show(j) { document.getElementById('ce-payout-result').textContent = JSON.stringify(j, null, 2); }
  document.getElementById('ce-payout-list').addEventListener('click', function () {
    var vendorId = parseInt(document.getElementById('ce-payout-vendor').value, 10);
    fetch('/Admin/CheckEngine/PayoutAdmin/List?vendorId=' + vendorId, { headers: headers(false) })
      .then(function (r) { return r.json(); }).then(show);
  });
  document.getElementById('ce-payout-generate').addEventListener('click', function () {
    var vendorId = parseInt(document.getElementById('ce-payout-vendor').value, 10);
    var end = new Date();
    var start = new Date(end.getTime() - 30 * 86400000);
    fetch('/Admin/CheckEngine/PayoutAdmin/Generate', {
      method: 'POST', headers: headers(true),
      body: JSON.stringify({ vendorId: vendorId, periodStartUtc: start.toISOString(), periodEndUtc: end.toISOString() })
    }).then(function (r) { return r.json(); }).then(show);
  });
  function action(path) {
    var id = parseInt(document.getElementById('ce-payout-statement').value, 10);
    fetch('/Admin/CheckEngine/PayoutAdmin/' + path, {
      method: 'POST', headers: headers(true), body: JSON.stringify({ statementId: id })
    }).then(function (r) { return r.json(); }).then(show);
  }
  document.getElementById('ce-payout-finalize').addEventListener('click', function () { action('Finalize'); });
  document.getElementById('ce-payout-push').addEventListener('click', function () { action('PushErp'); });
  document.getElementById('ce-payout-reconcile').addEventListener('click', function () { action('Reconcile'); });
})();
</script>
