@{
    Layout = "_AdminLayout";
    NopHtml.SetActiveMenuItemSystemName("TwinParticles.CheckEngine.FitmentAiReview");
    ViewBag.PageTitle = T("Plugins.TwinParticles.CheckEngine.Fitment.AiReview").Text;
}
@await Html.PartialAsync("~/Plugins/TwinParticles.CheckEngine/Views/Shared/_CheckEngineAdminAssets.cshtml")

<div class="content-header clearfix">
    <h1 class="float-left">@T("Plugins.TwinParticles.CheckEngine.Fitment.AiReview")</h1>
    <div class="float-right">
        <a class="btn btn-secondary" href="@Url.Action("Dashboard", "CheckEngine")">@T("Plugins.TwinParticles.CheckEngine.Dashboard")</a>
        <a class="btn btn-info" href="@Url.Action("ReviewBoard", "AiAdmin")">@T("Plugins.TwinParticles.CheckEngine.Ai.Review")</a>
    </div>
</div>

<section class="content ce-marketplace-admin">
    <div class="container-fluid">
        @Html.AntiForgeryToken()
        <script type="application/json" data-ce-i18n>@Html.Raw(System.Text.Json.JsonSerializer.Serialize(new {
            approve = T("Plugins.TwinParticles.CheckEngine.Common.Action.Approve").Text,
            reject = T("Plugins.TwinParticles.CheckEngine.Common.Action.Reject").Text,
            approved = T("Plugins.TwinParticles.CheckEngine.Fitment.AiReview.Approved").Text,
            rejected = T("Plugins.TwinParticles.CheckEngine.Fitment.AiReview.Rejected").Text,
            approvalFailed = T("Plugins.TwinParticles.CheckEngine.Fitment.AiReview.ApprovalFailed").Text,
            rejectionFailed = T("Plugins.TwinParticles.CheckEngine.Fitment.AiReview.RejectionFailed").Text,
            actionFailed = T("Plugins.TwinParticles.CheckEngine.Fitment.AiReview.ActionFailed").Text,
            inferFailed = T("Plugins.TwinParticles.CheckEngine.Fitment.AiReview.InferFailed").Text
        }))</script>
        <div class="ce-mp-alert ce-mp-alert--info" data-ce-admin-alert hidden role="status"></div>

        <div class="card card-default">
            <div class="card-header">
                <h3 class="card-title">@T("Plugins.TwinParticles.CheckEngine.Fitment.AiReview.Infer")</h3>
            </div>
            <div class="card-body">
                <div class="form-row">
                    <div class="form-group col-md-3">
                        <label>@T("Plugins.TwinParticles.CheckEngine.Seo.Admin.ProductId")</label>
                        <input id="ce-fit-product" type="number" class="form-control" />
                    </div>
                    <div class="form-group col-md-3">
                        <label>@T("Plugins.TwinParticles.CheckEngine.Seo.Admin.ConfigurationId")</label>
                        <input id="ce-fit-config" type="number" class="form-control" />
                    </div>
                    <div class="form-group col-md-4">
                        <label>@T("Plugins.TwinParticles.CheckEngine.Fitment.AiReview.ProductName")</label>
                        <input id="ce-fit-name" type="text" class="form-control" placeholder="@T("Plugins.TwinParticles.CheckEngine.Fitment.AiReview.ProductName.Placeholder")" />
                    </div>
                    <div class="form-group col-md-2 d-flex align-items-end">
                        <button id="ce-fit-infer" type="button" class="btn btn-primary btn-block">@T("Plugins.TwinParticles.CheckEngine.Fitment.AiReview.InferButton")</button>
                    </div>
                </div>
                <table class="table table-bordered table-sm mt-2" id="ce-fit-infer-result" hidden>
                    <tbody>
                        <tr><th>@T("Plugins.TwinParticles.CheckEngine.Common.Col.ClaimId")</th><td data-ce-fit-infer-id></td></tr>
                        <tr><th>@T("Plugins.TwinParticles.CheckEngine.Common.Col.Product")</th><td data-ce-fit-infer-product></td></tr>
                        <tr><th>@T("Plugins.TwinParticles.CheckEngine.Common.Col.Configuration")</th><td data-ce-fit-infer-config></td></tr>
                        <tr><th>@T("Plugins.TwinParticles.CheckEngine.Common.Col.Status")</th><td data-ce-fit-infer-status></td></tr>
                        <tr><th>@T("Plugins.TwinParticles.CheckEngine.Common.Col.Confidence")</th><td data-ce-fit-infer-confidence></td></tr>
                        <tr><th>@T("Plugins.TwinParticles.CheckEngine.Common.Col.Source")</th><td data-ce-fit-infer-source></td></tr>
                        <tr><th>@T("Plugins.TwinParticles.CheckEngine.Common.Col.Rationale")</th><td data-ce-fit-infer-rationale></td></tr>
                    </tbody>
                </table>
                <p class="text-danger mt-2 mb-0" id="ce-fit-infer-error" hidden></p>
            </div>
        </div>

        <div class="card card-default">
            <div class="card-header">
                <h3 class="card-title">@T("Plugins.TwinParticles.CheckEngine.Ai.Review.Fitment")</h3>
            </div>
            <div class="card-body">
                <p class="text-muted">@T("Plugins.TwinParticles.CheckEngine.Fitment.AiReview.Hint")</p>
                <div class="table-responsive">
                    <table class="table table-bordered table-striped" id="ce-fit-table">
                        <thead>
                            <tr>
                                <th>@T("Plugins.TwinParticles.CheckEngine.Common.Col.ClaimId")</th>
                                <th>@T("Plugins.TwinParticles.CheckEngine.Common.Col.Product")</th>
                                <th>@T("Plugins.TwinParticles.CheckEngine.Common.Col.Configuration")</th>
                                <th>@T("Plugins.TwinParticles.CheckEngine.Common.Col.Status")</th>
                                <th>@T("Plugins.TwinParticles.CheckEngine.Common.Col.Confidence")</th>
                                <th>@T("Plugins.TwinParticles.CheckEngine.Common.Col.Source")</th>
                                <th>@T("Plugins.TwinParticles.CheckEngine.Common.Col.Rationale")</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
(function () {
  var token = document.querySelector('input[name="__RequestVerificationToken"]');
  var i18n = (window.CheckEngineAdmin && CheckEngineAdmin.readI18n)
    ? CheckEngineAdmin.readI18n(document)
    : {};
  function pick(obj, camel, pascal) {
    if (!obj) return undefined;
    if (obj[camel] !== undefined) return obj[camel];
    if (obj[pascal] !== undefined) return obj[pascal];
    return undefined;
  }
  function errorMessage(err, fallback) {
    return (window.CheckEngineAdmin && CheckEngineAdmin.errorMessage)
      ? CheckEngineAdmin.errorMessage(err, fallback)
      : (fallback || 'Request failed.');
  }
  function showAlert(kind, message) {
    var el = document.querySelector('[data-ce-admin-alert]');
    if (!el) return;
    el.hidden = !message;
    el.textContent = message || '';
    el.className = 'ce-mp-alert ce-mp-alert--' + (kind || 'info');
  }
  function setText(selector, value) {
    var el = document.querySelector(selector);
    if (el) el.textContent = value == null || value === '' ? '—' : String(value);
  }
  function headers(json) {
    var h = { 'Accept': 'application/json' };
    if (json) h['Content-Type'] = 'application/json';
    if (token && token.value) h['RequestVerificationToken'] = token.value;
    return h;
  }
  function render(items) {
    var tbody = document.querySelector('#ce-fit-table tbody');
    tbody.innerHTML = '';
    (items || []).forEach(function (item) {
      var tr = document.createElement('tr');
      var source = item.provenance ? item.provenance.sourceKind : '';
      var sourceReference = item.provenance ? (item.provenance.sourceReference || '') : '';
      var rationale = sourceReference.indexOf('|') >= 0 ? sourceReference.split('|').slice(1).join('|') : '';
      tr.innerHTML =
        '<td>' + item.id + '</td>' +
        '<td>' + item.productId + '</td>' +
        '<td>' + item.vehicleConfigurationId + '</td>' +
        '<td>' + item.status + '</td>' +
        '<td>' + item.confidence + '</td>' +
        '<td>' + source + '</td>' +
        '<td><small>' + rationale + '</small></td>' +
        '<td><button type="button" class="btn btn-sm btn-primary mr-1" data-id="' + item.id + '" data-action="approve">' + (i18n.approve || 'Approve') + '</button>' +
        '<button type="button" class="btn btn-sm btn-danger" data-id="' + item.id + '" data-action="reject">' + (i18n.reject || 'Reject') + '</button></td>';
      tbody.appendChild(tr);
    });
    tbody.querySelectorAll('button[data-id]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        review(parseInt(btn.getAttribute('data-id'), 10), btn.getAttribute('data-action') === 'approve');
      });
    });
  }
  function load() {
    fetch('/Admin/CheckEngine/FitmentAdmin/AiQueue', { headers: headers(false) })
      .then(function (r) { return r.json(); })
      .then(render);
  }
  function review(claimId, approved) {
    var url = approved ? '/Admin/CheckEngine/FitmentAdmin/Approve' : '/Admin/CheckEngine/FitmentAdmin/Reject';
    fetch(url, {
      method: 'POST',
      headers: headers(true),
      credentials: 'same-origin',
      body: JSON.stringify({ claimId: claimId })
    }).then(function (r) {
      return r.json().then(function (body) { return { ok: r.ok, body: body }; }).catch(function () { return { ok: r.ok, body: {} }; });
    }).then(function (res) {
      if (!res.ok) {
        showAlert('error', errorMessage(res.body, approved
          ? (i18n.approvalFailed || 'Approval failed.')
          : (i18n.rejectionFailed || 'Rejection failed.')));
        return;
      }
      showAlert('success', approved ? (i18n.approved || 'Claim approved.') : (i18n.rejected || 'Claim rejected.'));
      load();
    }).catch(function (err) {
      showAlert('error', errorMessage(err, i18n.actionFailed || 'Action failed.'));
    });
  }
  document.getElementById('ce-fit-infer').addEventListener('click', function () {
    var productId = parseInt(document.getElementById('ce-fit-product').value, 10);
    var configurationId = parseInt(document.getElementById('ce-fit-config').value, 10);
    var productName = document.getElementById('ce-fit-name').value;
    var table = document.getElementById('ce-fit-infer-result');
    var errorEl = document.getElementById('ce-fit-infer-error');
    errorEl.hidden = true;
    table.hidden = true;
    fetch('/Admin/CheckEngine/FitmentAdmin/Infer', {
      method: 'POST',
      headers: headers(true),
      body: JSON.stringify({ productId: productId, vehicleConfigurationId: configurationId, productName: productName })
    }).then(function (r) {
      return r.json().then(function (body) { return { ok: r.ok, body: body }; });
    }).then(function (res) {
      if (!res.ok) {
        errorEl.hidden = false;
        errorEl.textContent = errorMessage(res.body, i18n.inferFailed || 'Inference failed.');
        showAlert('error', errorMessage(res.body, i18n.inferFailed || 'Inference failed.'));
        return;
      }
      var claim = res.body || {};
      var provenance = pick(claim, 'provenance', 'Provenance') || {};
      var sourceReference = pick(provenance, 'sourceReference', 'SourceReference') || '';
      var rationale = sourceReference.indexOf('|') >= 0 ? sourceReference.split('|').slice(1).join('|') : sourceReference;
      setText('[data-ce-fit-infer-id]', pick(claim, 'id', 'Id'));
      setText('[data-ce-fit-infer-product]', pick(claim, 'productId', 'ProductId'));
      setText('[data-ce-fit-infer-config]', pick(claim, 'vehicleConfigurationId', 'VehicleConfigurationId'));
      setText('[data-ce-fit-infer-status]', pick(claim, 'status', 'Status'));
      setText('[data-ce-fit-infer-confidence]', pick(claim, 'confidence', 'Confidence'));
      setText('[data-ce-fit-infer-source]', pick(provenance, 'sourceKind', 'SourceKind'));
      setText('[data-ce-fit-infer-rationale]', rationale);
      table.hidden = false;
      load();
    }).catch(function (err) {
      errorEl.hidden = false;
      errorEl.textContent = errorMessage(err, i18n.inferFailed || 'Inference failed.');
      showAlert('error', errorMessage(err, i18n.inferFailed || 'Inference failed.'));
    });
  });
  load();
})();
</script>
