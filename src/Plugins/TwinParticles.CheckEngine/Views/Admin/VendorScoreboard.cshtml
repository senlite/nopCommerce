@{
    Layout = "_AdminLayout";
    NopHtml.SetActiveMenuItemSystemName("TwinParticles.CheckEngine");
    ViewBag.PageTitle = T("Plugins.TwinParticles.CheckEngine.Marketplace.Scoreboard").Text;
}
@await Html.PartialAsync("~/Plugins/TwinParticles.CheckEngine/Views/Shared/_MarketplaceAdminAssets.cshtml")

<div class="content-header clearfix">
    <h1 class="float-left">@T("Plugins.TwinParticles.CheckEngine.Marketplace.Scoreboard")</h1>
    <div class="float-right">
        <a class="btn btn-secondary" href="@Url.Action("ReviewBoard", "VendorAdmin")">@T("Plugins.TwinParticles.CheckEngine.Marketplace.Review")</a>
        <a class="btn btn-secondary" href="@Url.Action("Index", "CommissionAdmin")">@T("Plugins.TwinParticles.CheckEngine.Commission.Configure")</a>
        <a class="btn btn-secondary" href="@Url.Action("Dashboard", "CheckEngine")">@T("Plugins.TwinParticles.CheckEngine.Dashboard")</a>
    </div>
</div>

<section class="content ce-marketplace-admin" data-ce-page="scoreboard">
    <div class="container-fluid">
        @Html.AntiForgeryToken()
        <script type="application/json" data-ce-i18n>@Html.Raw(System.Text.Json.JsonSerializer.Serialize(new {
            vendors = T("Plugins.TwinParticles.CheckEngine.Marketplace.Scoreboard.Vendors").Text,
            ordersSample = T("Plugins.TwinParticles.CheckEngine.Marketplace.Scoreboard.OrdersSample").Text,
            empty = T("Plugins.TwinParticles.CheckEngine.Marketplace.Scoreboard.Empty").Text
        }))</script>

        <p class="ce-mp-callout">@T("Plugins.TwinParticles.CheckEngine.Marketplace.Scoreboard.Hint")</p>

        <div class="ce-mp-stat-grid" data-ce-scoreboard-summary></div>

        <div class="card card-default">
            <div class="card-header">
                <h3 class="card-title">@T("Plugins.TwinParticles.CheckEngine.Marketplace.Scorecard")</h3>
            </div>
            <div class="card-body">
                <div class="ce-mp-table-wrap">
                    <table class="ce-mp-table" id="ce-vendor-scoreboard">
                        <thead>
                            <tr>
                                <th>@T("Plugins.TwinParticles.CheckEngine.Marketplace.Scoreboard.Col.Vendor")</th>
                                <th>@T("Plugins.TwinParticles.CheckEngine.Marketplace.Scorecard.FillRate")</th>
                                <th>@T("Plugins.TwinParticles.CheckEngine.Marketplace.Scorecard.CancelRate")</th>
                                <th>@T("Plugins.TwinParticles.CheckEngine.Marketplace.Scorecard.ClaimRejectRate")</th>
                                <th>@T("Plugins.TwinParticles.CheckEngine.Marketplace.Scorecard.OnTimeShipment")</th>
                                <th>@T("Plugins.TwinParticles.CheckEngine.Marketplace.Scoreboard.Col.Orders")</th>
                            </tr>
                        </thead>
                        <tbody data-ce-scoreboard-body></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</section>
