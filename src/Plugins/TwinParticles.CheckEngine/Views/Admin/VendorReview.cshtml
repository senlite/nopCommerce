@{
    Layout = "_AdminLayout";
    NopHtml.SetActiveMenuItemSystemName("TwinParticles.CheckEngine.VendorAdmin");
    ViewBag.PageTitle = T("Plugins.TwinParticles.CheckEngine.Marketplace.Review").Text;
}
@await Html.PartialAsync("~/Plugins/TwinParticles.CheckEngine/Views/Shared/_MarketplaceAdminAssets.cshtml")

<div class="content-header clearfix">
    <h1 class="float-left">@T("Plugins.TwinParticles.CheckEngine.Marketplace.Review")</h1>
    <div class="float-right">
        <a class="btn btn-secondary" href="@Url.Action("Scoreboard", "VendorAdmin")">@T("Plugins.TwinParticles.CheckEngine.Marketplace.Scoreboard")</a>
        <a class="btn btn-secondary" href="@Url.Action("Dashboard", "CheckEngine")">@T("Plugins.TwinParticles.CheckEngine.Dashboard")</a>
    </div>
</div>

<section class="content ce-marketplace-admin" data-ce-page="vendor-review" data-ce-queue-url="/Admin/CheckEngine/VendorAdmin/Queue">
    @* Operator queue: HasBankingDetails yes/no only — no ciphertext or payout payload. *@
    <div class="container-fluid">
        @Html.AntiForgeryToken()
        <script type="application/json" data-ce-i18n>@Html.Raw(System.Text.Json.JsonSerializer.Serialize(new {
            loading = T("Plugins.TwinParticles.CheckEngine.Marketplace.Admin.Loading").Text,
            empty = T("Plugins.TwinParticles.CheckEngine.Marketplace.Review.Empty").Text,
            errorLoad = T("Plugins.TwinParticles.CheckEngine.Marketplace.Admin.ErrorLoad").Text,
            review = T("Plugins.TwinParticles.CheckEngine.Marketplace.Review.Action.Review").Text,
            approve = T("Plugins.TwinParticles.CheckEngine.Marketplace.Review.Action.Approve").Text,
            reject = T("Plugins.TwinParticles.CheckEngine.Marketplace.Review.Action.Reject").Text,
            rejectNotes = T("Plugins.TwinParticles.CheckEngine.Marketplace.Review.RejectNotes").Text,
            actionOk = T("Plugins.TwinParticles.CheckEngine.Marketplace.Admin.ActionOk").Text,
            actionFail = T("Plugins.TwinParticles.CheckEngine.Marketplace.Admin.ActionFail").Text,
            yes = T("Admin.Common.Yes").Text,
            no = T("Admin.Common.No").Text
        }))</script>

        <div class="ce-mp-alert ce-mp-alert--info" data-ce-review-alert hidden role="status"></div>

        <div class="card card-default">
            <div class="card-header clearfix">
                <h3 class="card-title float-left">@T("Plugins.TwinParticles.CheckEngine.Marketplace.Review.Queue")</h3>
                <button type="button" class="btn btn-sm btn-secondary float-right" data-ce-review-refresh>@T("Plugins.TwinParticles.CheckEngine.Common.Refresh")</button>
            </div>
            <div class="card-body">
                <p class="ce-mp-callout">@T("Plugins.TwinParticles.CheckEngine.Marketplace.Review.Hint")</p>
                <div class="ce-mp-table-wrap">
                    <table class="ce-mp-table">
                        <thead>
                            <tr>
                                <th>@T("Plugins.TwinParticles.CheckEngine.Marketplace.Review.Col.Id")</th>
                                <th>@T("Plugins.TwinParticles.CheckEngine.Marketplace.Review.Col.LegalName")</th>
                                <th>@T("Plugins.TwinParticles.CheckEngine.Marketplace.Review.Col.Email")</th>
                                <th>@T("Plugins.TwinParticles.CheckEngine.Marketplace.Review.Col.Categories")</th>
                                <th>@T("Plugins.TwinParticles.CheckEngine.Marketplace.Review.Col.Status")</th>
                                <th>@T("Plugins.TwinParticles.CheckEngine.Marketplace.Review.Col.Agreement")</th>
                                <th>@T("Plugins.TwinParticles.CheckEngine.Marketplace.Review.Col.Banking")</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody data-ce-review-body></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</section>
