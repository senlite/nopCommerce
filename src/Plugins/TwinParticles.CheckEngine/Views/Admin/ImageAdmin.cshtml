@{
    Layout = "_AdminLayout";
    NopHtml.SetActiveMenuItemSystemName("TwinParticles.CheckEngine.ImageAdmin");
    ViewBag.PageTitle = T("Plugins.TwinParticles.CheckEngine.Image.Admin").Text;
}
@await Html.PartialAsync("~/Plugins/TwinParticles.CheckEngine/Views/Shared/_CheckEngineAdminAssets.cshtml")

<div class="content-header clearfix">
    <h1 class="float-left">@T("Plugins.TwinParticles.CheckEngine.Image.Admin")</h1>
    <div class="float-right">
        <a class="btn btn-secondary" href="@Url.Action("Dashboard", "CheckEngine")">@T("Plugins.TwinParticles.CheckEngine.Dashboard")</a>
    </div>
</div>

<section class="content ce-marketplace-admin" data-ce-page="image-admin">
    <div class="container-fluid">
        @Html.AntiForgeryToken()
        <script type="application/json" data-ce-i18n>@Html.Raw(System.Text.Json.JsonSerializer.Serialize(new {
            needProductUrl = T("Plugins.TwinParticles.CheckEngine.Image.Admin.NeedProductUrl").Text,
            replacing = T("Plugins.TwinParticles.CheckEngine.Image.Admin.Replacing").Text,
            replaceComplete = T("Plugins.TwinParticles.CheckEngine.Image.Admin.ReplaceComplete").Text,
            replaceFailed = T("Plugins.TwinParticles.CheckEngine.Image.Admin.ReplaceFailed").Text,
            needManifest = T("Plugins.TwinParticles.CheckEngine.Image.Admin.NeedManifest").Text,
            manifestApplied = T("Plugins.TwinParticles.CheckEngine.Image.Admin.ManifestApplied").Text,
            manifestFailed = T("Plugins.TwinParticles.CheckEngine.Image.Admin.ManifestFailed").Text,
            needSkus = T("Plugins.TwinParticles.CheckEngine.Image.Admin.NeedSkus").Text,
            applyingTemplate = T("Plugins.TwinParticles.CheckEngine.Image.Admin.ApplyingTemplate").Text,
            templateApplied = T("Plugins.TwinParticles.CheckEngine.Image.Admin.TemplateApplied").Text,
            templateFailed = T("Plugins.TwinParticles.CheckEngine.Image.Admin.TemplateFailed").Text,
            noRows = T("Plugins.TwinParticles.CheckEngine.Import.Batch.NoRows").Text,
            statSuccess = T("Plugins.TwinParticles.CheckEngine.Image.Admin.Stat.Success").Text,
            statPictureId = T("Plugins.TwinParticles.CheckEngine.Image.Admin.Stat.PictureId").Text,
            statPlaceholder = T("Plugins.TwinParticles.CheckEngine.Image.Admin.Stat.Placeholder").Text,
            statQuarantined = T("Plugins.TwinParticles.CheckEngine.Image.Admin.Stat.Quarantined").Text,
            statCdnUrl = T("Plugins.TwinParticles.CheckEngine.Image.Admin.Stat.CdnUrl").Text,
            statReplaced = T("Plugins.TwinParticles.CheckEngine.Image.Admin.Stat.Replaced").Text,
            statNotFound = T("Plugins.TwinParticles.CheckEngine.Image.Admin.Stat.NotFound").Text,
            statFailed = T("Plugins.TwinParticles.CheckEngine.Image.Admin.Stat.Failed").Text,
            statError = T("Plugins.TwinParticles.CheckEngine.Common.Col.Error").Text
        }))</script>
        <div class="ce-mp-alert ce-mp-alert--info" data-ce-admin-alert hidden role="status"></div>
        <div class="card card-default">
            <div class="card-header">
                <h3 class="card-title">@T("Plugins.TwinParticles.CheckEngine.Image.Admin.Replace")</h3>
            </div>
            <div class="card-body">
                <p class="ce-mp-callout">@T("Plugins.TwinParticles.CheckEngine.Image.Admin.Hint")</p>
                <div class="form-group col-md-4 pl-0">
                    <label>@T("Plugins.TwinParticles.CheckEngine.Image.Admin.ProductId")</label>
                    <input class="form-control ce-code" type="number" min="1" data-ce-image-product />
                </div>
                <div class="form-group col-md-8 pl-0">
                    <label>@T("Plugins.TwinParticles.CheckEngine.Image.Admin.SourceUrl")</label>
                    <input class="form-control" type="url" data-ce-image-url placeholder="https://" />
                </div>
                <div class="form-group col-md-4 pl-0">
                    <label>@T("Plugins.TwinParticles.CheckEngine.Image.Admin.SeoName")</label>
                    <input class="form-control" data-ce-image-seo />
                </div>
                <button type="button" class="btn btn-primary" data-ce-image-replace>@T("Plugins.TwinParticles.CheckEngine.Image.Admin.Replace")</button>
                <div class="ce-mp-stat-grid mt-3" data-ce-image-result></div>
            </div>
        </div>
        <div class="card card-default">
            <div class="card-header">
                <h3 class="card-title">@T("Plugins.TwinParticles.CheckEngine.Image.Admin.Manifest")</h3>
            </div>
            <div class="card-body">
                <p class="text-muted">@T("Plugins.TwinParticles.CheckEngine.Image.Admin.Manifest.Hint")</p>
                <textarea class="form-control" rows="8" data-ce-image-manifest placeholder="sku,sourceUrl"></textarea>
                <button type="button" class="btn btn-secondary mt-2" data-ce-image-manifest-submit>@T("Plugins.TwinParticles.CheckEngine.Image.Admin.Manifest.Submit")</button>
                <div class="ce-mp-stat-grid mt-3" data-ce-image-manifest-stats></div>
                <div class="ce-mp-table-wrap mt-3">
                    <table class="ce-mp-table">
                        <thead>
                            <tr>
                                <th>@T("Plugins.TwinParticles.CheckEngine.Common.Col.Sku")</th>
                                <th>@T("Plugins.TwinParticles.CheckEngine.Common.Col.Product")</th>
                                <th>@T("Plugins.TwinParticles.CheckEngine.Common.Col.Status")</th>
                                <th>@T("Plugins.TwinParticles.CheckEngine.Common.Col.Error")</th>
                            </tr>
                        </thead>
                        <tbody data-ce-image-manifest-rows></tbody>
                    </table>
                </div>
            </div>
        </div>
        <div class="card card-default">
            <div class="card-header">
                <h3 class="card-title">@T("Plugins.TwinParticles.CheckEngine.Image.Admin.Template")</h3>
            </div>
            <div class="card-body">
                <p class="text-muted">@T("Plugins.TwinParticles.CheckEngine.Image.Admin.Template.Hint")</p>
                <div class="form-group">
                    <label>@T("Plugins.TwinParticles.CheckEngine.Image.Admin.Template.Url")</label>
                    <input class="form-control ce-code" data-ce-image-template-url placeholder="https://cdn.example/{sku}.jpg" value="@ViewBag.SupplierImageUrlTemplate" />
                    <small class="form-text text-muted">@T("Plugins.TwinParticles.CheckEngine.Image.Admin.Template.Url.Hint")</small>
                </div>
                <textarea class="form-control mt-2" rows="6" data-ce-image-template-skus placeholder="SKU-1&#10;SKU-2"></textarea>
                <button type="button" class="btn btn-secondary mt-2" data-ce-image-template-submit>@T("Plugins.TwinParticles.CheckEngine.Image.Admin.Template.Submit")</button>
                <div class="ce-mp-stat-grid mt-3" data-ce-image-template-stats></div>
                <div class="ce-mp-table-wrap mt-3">
                    <table class="ce-mp-table">
                        <thead>
                            <tr>
                                <th>@T("Plugins.TwinParticles.CheckEngine.Common.Col.Sku")</th>
                                <th>@T("Plugins.TwinParticles.CheckEngine.Common.Col.Product")</th>
                                <th>@T("Plugins.TwinParticles.CheckEngine.Common.Col.Status")</th>
                                <th>@T("Plugins.TwinParticles.CheckEngine.Common.Col.Error")</th>
                            </tr>
                        </thead>
                        <tbody data-ce-image-template-rows></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</section>
