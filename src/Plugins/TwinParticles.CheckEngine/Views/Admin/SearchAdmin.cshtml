@{
    Layout = "_AdminLayout";
    NopHtml.SetActiveMenuItemSystemName("TwinParticles.CheckEngine.SearchAdmin");
    ViewBag.PageTitle = T("Plugins.TwinParticles.CheckEngine.Search.Admin").Text;
}
@await Html.PartialAsync("~/Plugins/TwinParticles.CheckEngine/Views/Shared/_CheckEngineAdminAssets.cshtml")

<div class="content-header clearfix">
    <h1 class="float-left">@T("Plugins.TwinParticles.CheckEngine.Search.Admin")</h1>
    <div class="float-right">
        <a class="btn btn-secondary" href="@Url.Action("Dashboard", "CheckEngine")">@T("Plugins.TwinParticles.CheckEngine.Dashboard")</a>
        <a class="btn btn-info" href="@Url.Action("Dashboard", "AiAdmin")">@T("Plugins.TwinParticles.CheckEngine.Ai.Dashboard")</a>
    </div>
</div>

<section class="content ce-marketplace-admin">
    <div class="container-fluid">
        @Html.AntiForgeryToken()
        <div class="ce-mp-alert ce-mp-alert--info" data-ce-admin-alert hidden role="status"></div>
        <div class="card card-default">
            <div class="card-header">
                <h3 class="card-title">@T("Plugins.TwinParticles.CheckEngine.Search.Admin.KeywordIndex")</h3>
            </div>
            <div class="card-body">
                <p id="ce-search-keyword-status" class="text-muted"></p>
                <button id="ce-search-rebuild-keyword" type="button" class="btn btn-primary">@T("Plugins.TwinParticles.CheckEngine.Search.Admin.RebuildKeyword")</button>
                <button id="ce-search-rebuild-keyword-and-embeddings" type="button" class="btn btn-outline-primary">@T("Plugins.TwinParticles.CheckEngine.Search.Admin.RebuildKeywordAndEmbeddings")</button>
            </div>
        </div>

        <div class="card card-default">
            <div class="card-header">
                <h3 class="card-title">@T("Plugins.TwinParticles.CheckEngine.Search.Admin.Embeddings")</h3>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-bordered" id="ce-search-embedding-table" data-ce-rebuild-label="@T("Plugins.TwinParticles.CheckEngine.Search.Admin.Embeddings.Rebuild")">
                        <thead>
                            <tr>
                                <th>@T("Plugins.TwinParticles.CheckEngine.Search.Admin.Embeddings.Locale")</th>
                                <th>@T("Plugins.TwinParticles.CheckEngine.Search.Admin.Embeddings.Ready")</th>
                                <th>@T("Plugins.TwinParticles.CheckEngine.Search.Admin.Embeddings.Vectors")</th>
                                <th>@T("Plugins.TwinParticles.CheckEngine.Search.Admin.Embeddings.Catalog")</th>
                                <th>@T("Plugins.TwinParticles.CheckEngine.Search.Admin.Embeddings.Stale")</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
                <button id="ce-search-rebuild-embeddings-all" type="button" class="btn btn-warning">@T("Plugins.TwinParticles.CheckEngine.Search.Admin.RebuildEmbeddingsAll")</button>
                <button id="ce-search-refresh-embeddings" type="button" class="btn btn-secondary">@T("Plugins.TwinParticles.CheckEngine.Search.Admin.RefreshEmbeddings")</button>
                <p id="ce-search-rebuild-result" class="mt-3 text-muted"></p>
            </div>
        </div>

        <div class="card card-default">
            <div class="card-header">
                <h3 class="card-title">@T("Plugins.TwinParticles.CheckEngine.Search.Synonyms")</h3>
            </div>
            <div class="card-body">
                <p class="text-muted">@T("Plugins.TwinParticles.CheckEngine.Search.Synonyms.Hint")</p>
                <div class="table-responsive">
                    <table class="table table-bordered" id="ce-search-synonyms-table">
                        <thead>
                            <tr>
                                <th>@T("Plugins.TwinParticles.CheckEngine.Search.Synonyms.Arabic")</th>
                                <th>@T("Plugins.TwinParticles.CheckEngine.Search.Synonyms.English")</th>
                                <th>@T("Plugins.TwinParticles.CheckEngine.Search.Synonyms.Source")</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
                <div class="form-group">
                    <label for="ce-search-synonyms-overrides">@T("Plugins.TwinParticles.CheckEngine.Search.Synonyms.OverridesJson")</label>
                    <textarea id="ce-search-synonyms-overrides" class="form-control" rows="8" spellcheck="false"></textarea>
                </div>
                <button id="ce-search-synonyms-save" type="button" class="btn btn-primary">@T("Plugins.TwinParticles.CheckEngine.Search.Synonyms.Save")</button>
                <p id="ce-search-synonyms-status" class="mt-3 text-muted"></p>
            </div>
        </div>

        <div class="card card-default">
            <div class="card-header">
                <h3 class="card-title">@T("Plugins.TwinParticles.CheckEngine.Search.Admin.Analytics")</h3>
            </div>
            <div class="card-body">
                <p class="text-muted">@T("Plugins.TwinParticles.CheckEngine.Search.Admin.Analytics.Hint")</p>
                <div class="form-group col-md-3 pl-0">
                    <label for="ce-search-analytics-days">@T("Plugins.TwinParticles.CheckEngine.Search.Admin.Analytics.Days")</label>
                    <input id="ce-search-analytics-days" class="form-control" type="number" min="1" max="365" value="30" />
                </div>
                <button id="ce-search-analytics-load" type="button" class="btn btn-secondary">@T("Plugins.TwinParticles.CheckEngine.Common.Refresh")</button>
                <div class="table-responsive mt-3">
                    <table class="table table-bordered" id="ce-search-analytics-table">
                        <tbody>
                            <tr><th>@T("Plugins.TwinParticles.CheckEngine.Search.Admin.Analytics.Searches")</th><td data-ce-search-count>—</td></tr>
                            <tr><th>@T("Plugins.TwinParticles.CheckEngine.Search.Admin.Analytics.Zero")</th><td data-ce-zero-count>—</td></tr>
                            <tr><th>@T("Plugins.TwinParticles.CheckEngine.Search.Admin.Analytics.Clicks")</th><td data-ce-click-count>—</td></tr>
                            <tr><th>@T("Plugins.TwinParticles.CheckEngine.Search.Admin.Analytics.Ctr")</th><td data-ce-ctr>—</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
(function () {
  var token = document.querySelector('input[name="__RequestVerificationToken"]');
  var rebuildLabel = document.querySelector('#ce-search-embedding-table').getAttribute('data-ce-rebuild-label') || 'Rebuild';
  function headers(json) {
    var h = { 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' };
    if (json) h['Content-Type'] = 'application/json';
    if (token && token.value) h['RequestVerificationToken'] = token.value;
    return h;
  }
  function errorMessage(err, fallback) {
    return (window.CheckEngineAdmin && CheckEngineAdmin.errorMessage)
      ? CheckEngineAdmin.errorMessage(err, fallback)
      : (fallback || 'Request failed.');
  }
  function showAlert(kind, message) {
    var el = document.querySelector('[data-ce-admin-alert]');
    if (!el) return;
    el.hidden = !message;
    el.textContent = message || '';
    el.className = 'ce-mp-alert ce-mp-alert--' + (kind || 'info');
  }
  function post(url, body) {
    return fetch(url, {
      method: 'POST',
      headers: headers(body != null),
      credentials: 'same-origin',
      body: body != null ? JSON.stringify(body) : undefined
    }).then(function (r) {
      return r.json().then(function (data) { return { ok: r.ok, body: data }; }).catch(function () { return { ok: r.ok, body: {} }; });
    });
  }
  function renderKeyword(state) {
    var text = 'Healthy: ' + (state.isHealthy ? 'yes' : 'no') +
      ' · Indexed: ' + (state.indexedCount || 0) +
      ' · Last rebuild: ' + (state.lastRebuildUtc || 'never');
    document.getElementById('ce-search-keyword-status').textContent = text;
  }
  function renderEmbeddings(embeddings) {
    var tbody = document.querySelector('#ce-search-embedding-table tbody');
    tbody.innerHTML = '';
    (embeddings || []).forEach(function (row) {
      var tr = document.createElement('tr');
      tr.innerHTML =
        '<td>' + row.locale + '</td>' +
        '<td>' + (row.semanticReady ? 'yes' : 'no') + '</td>' +
        '<td>' + (row.count || 0) + '</td>' +
        '<td>' + (row.catalogCount || 0) + '</td>' +
        '<td>' + (row.staleCount || 0) + '</td>' +
        '<td><button type="button" class="btn btn-sm btn-secondary" data-ce-locale="' + row.locale + '">' + rebuildLabel + '</button></td>';
      tbody.appendChild(tr);
    });
    tbody.querySelectorAll('[data-ce-locale]').forEach(function (button) {
      button.addEventListener('click', function () {
        rebuildEmbeddings(button.getAttribute('data-ce-locale'));
      });
    });
  }
  function load() {
    fetch('/Admin/CheckEngine/SearchAdmin/Status', { headers: headers(false) })
      .then(function (r) { return r.json(); })
      .then(function (data) {
        renderKeyword(data.keywordState || {});
        renderEmbeddings(data.embeddings || []);
      });
  }
  function rebuildEmbeddings(locale) {
    var url = locale
      ? '/Admin/CheckEngine/SearchAdmin/RebuildEmbeddings?locale=' + encodeURIComponent(locale)
      : '/Admin/CheckEngine/SearchAdmin/RebuildEmbeddingsAll';
    post(url).then(function (res) {
      if (!res.ok) {
        showAlert('error', errorMessage(res.body, 'Rebuild failed.'));
        return;
      }
      showAlert('success', '');
      var data = res.body || {};
      if (data.locales) {
        document.getElementById('ce-search-rebuild-result').textContent =
          'Rebuilt all locales · indexed ' + (data.totalIndexed || 0) + ' vectors.';
      } else {
        document.getElementById('ce-search-rebuild-result').textContent =
          'Locale ' + (data.locale || locale) + ': indexed ' + (data.indexed || 0) +
          ', skipped ' + (data.skipped || 0) + ', failed ' + (data.failed || 0) +
          ' of ' + (data.catalogCount || 0) + '.';
      }
      load();
    }).catch(function (err) {
      showAlert('error', errorMessage(err, 'Rebuild failed.'));
    });
  }
  document.getElementById('ce-search-rebuild-keyword').addEventListener('click', function () {
    post('/Admin/CheckEngine/SearchAdmin/Rebuild').then(function (res) {
      if (!res.ok) {
        showAlert('error', errorMessage(res.body, 'Keyword rebuild failed.'));
        return;
      }
      showAlert('success', 'Keyword index rebuilt.');
      load();
    }).catch(function (err) {
      showAlert('error', errorMessage(err, 'Keyword rebuild failed.'));
    });
  });
  document.getElementById('ce-search-rebuild-keyword-and-embeddings').addEventListener('click', function () {
    post('/Admin/CheckEngine/SearchAdmin/RebuildKeywordAndRefreshEmbeddings').then(function (res) {
      if (!res.ok) {
        showAlert('error', errorMessage(res.body, 'Rebuild failed.'));
        return;
      }
      showAlert('success', '');
      document.getElementById('ce-search-rebuild-result').textContent =
        'Keyword rebuild complete · refreshed ' + (res.body.totalIndexed || 0) + ' stale embedding vectors.';
      load();
    }).catch(function (err) {
      showAlert('error', errorMessage(err, 'Rebuild failed.'));
    });
  });
  document.getElementById('ce-search-rebuild-embeddings-all').addEventListener('click', function () {
    rebuildEmbeddings(null);
  });
  document.getElementById('ce-search-refresh-embeddings').addEventListener('click', function () {
    post('/Admin/CheckEngine/SearchAdmin/RefreshEmbeddingsIncrementalAll').then(function (res) {
      if (!res.ok) {
        showAlert('error', errorMessage(res.body, 'Refresh failed.'));
        return;
      }
      showAlert('success', '');
      document.getElementById('ce-search-rebuild-result').textContent =
        'Incremental refresh indexed ' + (res.body.totalIndexed || 0) + ' stale vectors.';
      load();
    }).catch(function (err) {
      showAlert('error', errorMessage(err, 'Refresh failed.'));
    });
  });
  function loadSynonyms() {
    fetch('/Admin/CheckEngine/SearchAdmin/SynonymsData', { headers: headers(false) })
      .then(function (r) { return r.json(); })
      .then(function (data) {
        var tbody = document.querySelector('#ce-search-synonyms-table tbody');
        tbody.innerHTML = '';
        var overrides = {};
        (data.terms || []).forEach(function (row) {
          var tr = document.createElement('tr');
          tr.innerHTML =
            '<td>' + row.arabic + '</td>' +
            '<td>' + row.english + '</td>' +
            '<td>' + row.source + '</td>';
          tbody.appendChild(tr);
          if (row.source === 'override') {
            overrides[row.arabic] = row.english;
          }
        });
        document.getElementById('ce-search-synonyms-overrides').value =
          Object.keys(overrides).length ? JSON.stringify(overrides, null, 2) : '{}';
        document.getElementById('ce-search-synonyms-status').textContent =
          'Embedded: ' + (data.embeddedCount || 0) + ' · Overrides: ' + (data.overrideCount || 0);
      });
  }
  document.getElementById('ce-search-synonyms-save').addEventListener('click', function () {
    var raw = document.getElementById('ce-search-synonyms-overrides').value || '{}';
    var overrides;
    try {
      overrides = JSON.parse(raw);
    } catch (e) {
      showAlert('error', 'Invalid JSON.');
      return;
    }
    post('/Admin/CheckEngine/SearchAdmin/SaveSynonyms', { overrides: overrides }).then(function (res) {
      if (!res.ok) {
        showAlert('error', errorMessage(res.body, 'Save failed.'));
        return;
      }
      showAlert('success', '');
      document.getElementById('ce-search-synonyms-status').textContent =
        'Saved ' + (res.body.overrideCount || 0) + ' override(s). Rebuild embeddings to apply index-time expansion.';
      loadSynonyms();
    }).catch(function (err) {
      showAlert('error', errorMessage(err, 'Save failed.'));
    });
  });
  function loadAnalytics() {
    var days = document.getElementById('ce-search-analytics-days').value || 30;
    fetch('/Admin/CheckEngine/SearchAdmin/Analytics?days=' + encodeURIComponent(days), { headers: headers(false) })
      .then(function (r) { return r.json(); })
      .then(function (data) {
        document.querySelector('[data-ce-search-count]').textContent = data.searchCount != null ? data.searchCount : (data.SearchCount || 0);
        document.querySelector('[data-ce-zero-count]').textContent = data.zeroResultCount != null ? data.zeroResultCount : (data.ZeroResultCount || 0);
        document.querySelector('[data-ce-click-count]').textContent = data.clickCount != null ? data.clickCount : (data.ClickCount || 0);
        var ctr = data.clickThroughRate != null ? data.clickThroughRate : data.ClickThroughRate;
        document.querySelector('[data-ce-ctr]').textContent = ctr == null ? '—' : (Math.round(ctr * 1000) / 10) + '%';
      });
  }
  document.getElementById('ce-search-analytics-load').addEventListener('click', loadAnalytics);
  load();
  loadSynonyms();
  loadAnalytics();
})();
</script>
