@{
    Layout = "_AdminLayout";
    NopHtml.SetActiveMenuItemSystemName("TwinParticles.CheckEngine.SeoAdmin");
    ViewBag.PageTitle = T("Plugins.TwinParticles.CheckEngine.Seo.Admin").Text;
}
@await Html.PartialAsync("~/Plugins/TwinParticles.CheckEngine/Views/Shared/_CheckEngineAdminAssets.cshtml")

<div class="content-header clearfix">
    <h1 class="float-left">@T("Plugins.TwinParticles.CheckEngine.Seo.Admin")</h1>
    <div class="float-right">
        <a class="btn btn-secondary" href="@Url.Action("Dashboard", "CheckEngine")">@T("Plugins.TwinParticles.CheckEngine.Dashboard")</a>
    </div>
</div>

<section class="content ce-marketplace-admin" data-ce-page="seo-admin">
    <div class="container-fluid">
        @Html.AntiForgeryToken()
        <div class="ce-mp-alert ce-mp-alert--info" data-ce-admin-alert hidden role="status"></div>
        <div class="card card-default">
            <div class="card-header clearfix">
                <h3 class="card-title float-left">@T("Plugins.TwinParticles.CheckEngine.Seo.Admin.Sitemap")</h3>
                <div class="float-right">
                    <button type="button" class="btn btn-sm btn-warning" data-ce-seo-rebuild>@T("Plugins.TwinParticles.CheckEngine.Seo.Admin.Rebuild")</button>
                    <button type="button" class="btn btn-sm btn-secondary" data-ce-seo-refresh>@T("Plugins.TwinParticles.CheckEngine.Common.Refresh")</button>
                </div>
            </div>
            <div class="card-body">
                <p class="ce-mp-callout">@T("Plugins.TwinParticles.CheckEngine.Seo.Admin.Hint")</p>
                <div class="ce-mp-table-wrap">
                    <table class="ce-mp-table">
                        <thead><tr><th>@T("Plugins.TwinParticles.CheckEngine.Common.Col.Url")</th></tr></thead>
                        <tbody data-ce-seo-body></tbody>
                    </table>
                </div>
            </div>
        </div>
        <div class="card card-default">
            <div class="card-header">
                <h3 class="card-title">@T("Plugins.TwinParticles.CheckEngine.Seo.Admin.Generate")</h3>
            </div>
            <div class="card-body">
                <p class="text-muted">@T("Plugins.TwinParticles.CheckEngine.Seo.Admin.Generate.Hint")</p>
                <div class="form-row">
                    <div class="form-group col-md-3">
                        <label>@T("Plugins.TwinParticles.CheckEngine.Seo.Admin.ConfigurationId")</label>
                        <input class="form-control ce-code" type="number" min="1" data-ce-seo-config />
                    </div>
                    <div class="form-group col-md-3">
                        <label>@T("Plugins.TwinParticles.CheckEngine.Seo.Admin.ProductId")</label>
                        <input class="form-control ce-code" type="number" min="1" data-ce-seo-product placeholder="optional" />
                    </div>
                    <div class="form-group col-md-2">
                        <label>@T("Plugins.TwinParticles.CheckEngine.Seo.Admin.Locale")</label>
                        <select class="form-control" data-ce-seo-locale>
                            <option value="en">en</option>
                            <option value="ar">ar</option>
                        </select>
                    </div>
                    <div class="form-group col-md-4 d-flex align-items-end">
                        <button type="button" class="btn btn-primary mr-2" data-ce-seo-generate-vehicle>@T("Plugins.TwinParticles.CheckEngine.Seo.Admin.GenerateVehicle")</button>
                        <button type="button" class="btn btn-secondary" data-ce-seo-generate-part>@T("Plugins.TwinParticles.CheckEngine.Seo.Admin.GeneratePart")</button>
                    </div>
                </div>
                <div class="ce-mp-stat-grid" data-ce-seo-result></div>
            </div>
        </div>
    </div>
</section>
