@{
    Layout = "_AdminLayout";
    NopHtml.SetActiveMenuItemSystemName("TwinParticles.CheckEngine");
    ViewBag.PageTitle = T("Plugins.TwinParticles.CheckEngine.Import.Batch").Text;
}
@await Html.PartialAsync("~/Plugins/TwinParticles.CheckEngine/Views/Shared/_CheckEngineAdminAssets.cshtml")

<div class="content-header clearfix">
    <h1 class="float-left">@T("Plugins.TwinParticles.CheckEngine.Import.Batch")</h1>
    <div class="float-right">
        <a class="btn btn-secondary" href="@Url.Action("Dashboard", "CheckEngine")">@T("Plugins.TwinParticles.CheckEngine.Dashboard")</a>
    </div>
</div>

<section class="content ce-marketplace-admin" data-ce-page="import-batch">
    <div class="container-fluid">
        @Html.AntiForgeryToken()
        <div class="ce-mp-alert ce-mp-alert--info" data-ce-admin-alert hidden role="status"></div>
        <div class="card card-default">
            <div class="card-body">
                <p class="ce-mp-callout">@T("Plugins.TwinParticles.CheckEngine.Import.Batch.Hint")</p>
                <div class="ce-mp-toolbar">
                    <div class="ce-mp-field">
                        <label>@T("Plugins.TwinParticles.CheckEngine.Import.Batch.File")</label>
                        <input type="file" class="form-control" data-ce-import-file accept=".csv,.xlsx,.xls,.pdf,text/csv,application/pdf" />
                    </div>
                    <div class="ce-mp-field">
                        <label>@T("Plugins.TwinParticles.CheckEngine.Import.Batch.Format")</label>
                        <select class="form-control" data-ce-import-format>
                            <option value="1">CSV</option>
                            <option value="2">Excel</option>
                            <option value="3">PDF</option>
                        </select>
                    </div>
                    <label class="mb-0 mr-3">
                        <input type="checkbox" data-ce-import-run-dry-run checked="checked" />
                        @T("Plugins.TwinParticles.CheckEngine.Import.Batch.PublishDryRun")
                    </label>
                    <button type="button" class="ce-btn ce-btn--primary" data-ce-import-run>@T("Plugins.TwinParticles.CheckEngine.Import.Batch.Upload")</button>
                </div>
                <div class="ce-mp-toolbar">
                    <div class="ce-mp-field">
                        <label>@T("Plugins.TwinParticles.CheckEngine.Import.Batch.Id")</label>
                        <input class="ce-mp-input ce-code" data-ce-import-batch placeholder="batch-guid" value="@ViewBag.BatchId" />
                    </div>
                    <button type="button" class="ce-btn ce-btn--primary" data-ce-import-load>@T("Admin.Common.View")</button>
                </div>
                <div class="ce-mp-stat-grid mt-3" data-ce-import-stats></div>
                <div class="ce-mp-toolbar mt-3">
                    <label class="mb-0 mr-3">
                        <input type="checkbox" data-ce-import-dry-run checked="checked" />
                        @T("Plugins.TwinParticles.CheckEngine.Import.Batch.PublishDryRun")
                    </label>
                    <button type="button" class="ce-btn ce-btn--primary" data-ce-import-publish>@T("Plugins.TwinParticles.CheckEngine.Import.Batch.Publish")</button>
                </div>
                <div class="ce-mp-stat-grid mt-3" data-ce-import-publish-stats></div>
                <div class="ce-mp-table-wrap mt-3">
                    <table class="ce-mp-table">
                        <thead>
                            <tr>
                                <th>Row</th>
                                <th>Review</th>
                                <th>OEM</th>
                                <th>Vehicle</th>
                                <th>Published</th>
                                <th>Error</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody data-ce-import-rows></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</section>
