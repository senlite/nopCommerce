@{
    NopHtml.AddHeadCustomParts("<script src=\"/Plugins/TwinParticles.CheckEngine/Content/checkengine-licence-admin.js?v=0.94.0\" defer></script>");
}

<div class="card card-default" data-ce-licence-panel>
    <div class="card-header">
        <h3 class="card-title">@T("Plugins.TwinParticles.CheckEngine.Licence.Panel.Title")</h3>
    </div>
    <div class="card-body">
        <p class="text-muted">@T("Plugins.TwinParticles.CheckEngine.Licence.Panel.Hint")</p>
        <script type="application/json" data-ce-i18n>@Html.Raw(System.Text.Json.JsonSerializer.Serialize(new {
            yes = T("Plugins.TwinParticles.CheckEngine.Common.Yes").Text,
            no = T("Plugins.TwinParticles.CheckEngine.Common.No").Text,
            activated = T("Plugins.TwinParticles.CheckEngine.Licence.Panel.Activated").Text,
            heartbeatRecorded = T("Plugins.TwinParticles.CheckEngine.Licence.Panel.HeartbeatRecorded").Text,
            activationFailed = T("Plugins.TwinParticles.CheckEngine.Licence.Panel.ActivationFailed").Text,
            loadFailed = T("Plugins.TwinParticles.CheckEngine.Licence.Panel.LoadFailed").Text,
            states = new System.Collections.Generic.Dictionary<string, string>
            {
                ["inactive"] = T("Plugins.TwinParticles.CheckEngine.Licence.Panel.State.Inactive").Text,
                ["active"] = T("Plugins.TwinParticles.CheckEngine.Licence.Panel.State.Active").Text,
                ["invalid"] = T("Plugins.TwinParticles.CheckEngine.Licence.Panel.State.Invalid").Text,
                ["read_only"] = T("Plugins.TwinParticles.CheckEngine.Licence.Panel.State.ReadOnly").Text
            },
            reasons = new System.Collections.Generic.Dictionary<string, string>
            {
                ["licence.not_activated"] = T("Plugins.TwinParticles.CheckEngine.Licence.Reason.NotActivated").Text,
                ["licence.invalid_key"] = T("Plugins.TwinParticles.CheckEngine.Licence.Reason.InvalidKey").Text,
                ["licence.unsigned_key_not_allowed"] = T("Plugins.TwinParticles.CheckEngine.Licence.Reason.UnsignedKeyNotAllowed").Text,
                ["licence.bundle_malformed"] = T("Plugins.TwinParticles.CheckEngine.Licence.Reason.BundleMalformed").Text,
                ["licence.bundle_signature_invalid"] = T("Plugins.TwinParticles.CheckEngine.Licence.Reason.BundleSignatureInvalid").Text,
                ["licence.bundle_missing_expiry"] = T("Plugins.TwinParticles.CheckEngine.Licence.Reason.BundleMissingExpiry").Text,
                ["licence.bundle_invalid_expiry"] = T("Plugins.TwinParticles.CheckEngine.Licence.Reason.BundleInvalidExpiry").Text,
                ["licence.bundle_expired"] = T("Plugins.TwinParticles.CheckEngine.Licence.Reason.BundleExpired").Text,
                ["licence.grace_expired"] = T("Plugins.TwinParticles.CheckEngine.Licence.Reason.GraceExpired").Text,
                ["licence.read_only"] = T("Plugins.TwinParticles.CheckEngine.Licence.ReadOnly.Message").Text
            }
        }))</script>
        <div class="alert alert-info" data-ce-licence-alert hidden role="status"></div>
        <p class="font-weight-bold mb-1">@T("Plugins.TwinParticles.CheckEngine.Licence.Panel.Status")</p>
        <table class="table table-bordered table-sm">
            <tbody>
                <tr><th>@T("Plugins.TwinParticles.CheckEngine.Licence.Panel.Status")</th><td data-ce-licence-state>@T("Plugins.TwinParticles.CheckEngine.Common.Loading")</td></tr>
                <tr><th>@T("Plugins.TwinParticles.CheckEngine.Licence.Panel.Active")</th><td data-ce-licence-active>—</td></tr>
                <tr><th>@T("Plugins.TwinParticles.CheckEngine.Licence.Panel.Tier")</th><td data-ce-licence-tier>—</td></tr>
                <tr><th>@T("Plugins.TwinParticles.CheckEngine.Licence.Panel.Marketplace")</th><td data-ce-licence-marketplace>—</td></tr>
                <tr><th>@T("Plugins.TwinParticles.CheckEngine.Licence.Panel.Workshop")</th><td data-ce-licence-workshop>—</td></tr>
                <tr><th>@T("Plugins.TwinParticles.CheckEngine.Licence.Panel.Fleet")</th><td data-ce-licence-fleet>—</td></tr>
                <tr><th>@T("Plugins.TwinParticles.CheckEngine.Licence.Panel.Dealer")</th><td data-ce-licence-dealer>—</td></tr>
                <tr><th>@T("Plugins.TwinParticles.CheckEngine.Licence.Panel.LastHeartbeat")</th><td data-ce-licence-last-heartbeat>—</td></tr>
                <tr><th>@T("Plugins.TwinParticles.CheckEngine.Licence.Panel.Reason")</th><td data-ce-licence-reason>—</td></tr>
            </tbody>
        </table>
        <div class="form-group">
            <label for="ce-licence-key-input">@T("Plugins.TwinParticles.CheckEngine.Licence.Panel.Key")</label>
            <textarea id="ce-licence-key-input" data-ce-licence-key class="form-control" rows="3" placeholder="ce-lic-v1.…"></textarea>
        </div>
        <button type="button" class="btn btn-primary" data-ce-licence-activate>@T("Plugins.TwinParticles.CheckEngine.Licence.Panel.Activate")</button>
        <button type="button" class="btn btn-secondary ml-2" data-ce-licence-heartbeat>@T("Plugins.TwinParticles.CheckEngine.Licence.Panel.Heartbeat")</button>
        <p class="form-text text-muted mt-3 mb-0">
            <a href="/Admin/CheckEngine/PortalAdmin/Accounts">@T("Plugins.TwinParticles.CheckEngine.Portal.Admin.Title")</a>
        </p>
    </div>
</div>
