@model TwinParticles.CheckEngine.Components.CheckEngineThemeChromeViewComponent.ThemeChromeModel

@{
    var zone = (Model.WidgetZone ?? string.Empty).ToLowerInvariant();
}

@*
    Assets are registered once from the body-start zone. Nothing visible is rendered there so the
    Check Engine chrome can never overlap the host theme's header/logo.
*@
@if (zone == "body_start_html_tag_after")
{
    NopHtml.AddCssFileParts("~/Plugins/TwinParticles.CheckEngine/Content/checkengine-tokens.css");
    NopHtml.AddCssFileParts("~/Plugins/TwinParticles.CheckEngine/Content/checkengine-theme.css");
    NopHtml.AddHeadCustomParts("<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">");
    NopHtml.AddHeadCustomParts("<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>");
    NopHtml.AddHeadCustomParts("<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Outfit:wght@500;600;700&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Sans+Arabic:wght@400;600&family=IBM+Plex+Mono:wght@400;500&display=swap\">");

    <script src="~/Plugins/TwinParticles.CheckEngine/Content/checkengine-storefront.js" asp-append-version="true"></script>
}
else if (zone == "header_after")
{
    @* Keyboard-native mega menu: details/summary provides Enter/Space toggle, focus order and
       Escape-free progressive enhancement without a JavaScript dependency. *@
    <nav class="ce-root ce-mega-nav" aria-label="@Model.MenuText.AriaLabel">
        <details class="ce-mega">
            <summary class="ce-mega__trigger" tabindex="0" aria-expanded="false">
                <svg class="ce-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
                    <path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round" />
                </svg>
                <span>@Model.MenuText.AllParts</span>
                <svg class="ce-icon ce-mega__caret" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
                    <path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
            </summary>
            <div class="ce-mega__panel">
                <div class="ce-mega__heading">
                    <span class="ce-mega__eyebrow">@Model.MenuText.Eyebrow</span>
                    <strong>@Model.MenuText.Title</strong>
                    <span>@Model.MenuText.Hint</span>
                </div>
                @if (Model.MenuGroups.Count > 0)
                {
                    <div class="ce-mega__grid">
                        @foreach (var group in Model.MenuGroups)
                        {
                            <section class="ce-mega__group">
                                <a class="ce-mega__group-title" href="@Url.RouteUrl("Category", new { SeName = group.SeName })">
                                    @group.Name
                                    <svg class="ce-icon ce-icon--directional" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
                                        <path d="M9 18l6-6-6-6" stroke-linecap="round" stroke-linejoin="round" />
                                    </svg>
                                </a>
                                @if (group.Children.Count > 0)
                                {
                                    <ul class="ce-mega__links">
                                        @foreach (var child in group.Children)
                                        {
                                            <li>
                                                <a href="@Url.RouteUrl("Category", new { SeName = child.SeName })">@child.Name</a>
                                            </li>
                                        }
                                    </ul>
                                }
                            </section>
                        }
                    </div>
                }
                else
                {
                    <p class="ce-mega__empty">@Model.MenuText.Empty</p>
                }
                <div class="ce-mega__footer">
                    <button type="button" class="ce-btn ce-btn--primary" data-ce-action="add-vehicle">
                        @Model.MenuText.AddVehicle
                    </button>
                    <button type="button" class="ce-btn ce-btn--quiet" data-ce-action="focus-search">
                        @Model.MenuText.SearchByOem
                    </button>
                </div>
            </div>
        </details>
    </nav>

    @* Search rail: unified query + vehicle context chip + submit, per the design system layout regions. *@
    <div class="ce-root ce-rail" data-ce-theme="sticky-search" role="search">
        <span hidden data-ce-antiforgery>@Html.AntiForgeryToken()</span>
        <div class="ce-rail__inner">
            <button type="button"
                    class="ce-chip"
                    id="ce-garage-chip"
                    data-ce-theme="garage-widget"
                    data-ce-state="empty"
                    aria-haspopup="dialog"
                    aria-expanded="false">
                <svg class="ce-icon ce-chip__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true" focusable="false">
                    <path d="M5 13l1.5-4.5A2 2 0 0 1 8.4 7h7.2a2 2 0 0 1 1.9 1.5L19 13" stroke-linecap="round" stroke-linejoin="round" />
                    <path d="M4 13h16v4a1 1 0 0 1-1 1h-1a1 1 0 0 1-1-1v-1H7v1a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1v-4z" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                <span class="ce-chip__text">
                    <span class="ce-chip__label">@T("Plugins.TwinParticles.CheckEngine.Garage.Label")</span>
                    <span class="ce-chip__value" id="ce-garage-chip-value">@T("Plugins.TwinParticles.CheckEngine.Garage.SelectVehicle")</span>
                </span>
            </button>

            @* Vehicle switcher. Kept as a native select so it is keyboard and screen-reader friendly. *@
            <label class="ce-visually-hidden" for="ce-vehicle-selector">@T("Plugins.TwinParticles.CheckEngine.Garage.VehicleSelector")</label>
            <select id="ce-vehicle-selector" class="ce-select" name="vehicleSelector" data-ce-theme="vehicle-selector">
                <option value="">@T("Plugins.TwinParticles.CheckEngine.Garage.Empty")</option>
            </select>

            <form class="ce-search" id="ce-search-form" method="post" action="/check-engine/search/query" role="none">
                <div class="ce-search__field">
                    <svg class="ce-icon ce-search__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true" focusable="false">
                        <circle cx="11" cy="11" r="7" />
                        <path d="M20 20l-3.5-3.5" stroke-linecap="round" />
                    </svg>
                    <label class="ce-visually-hidden" for="ce-sticky-search-input">@T("Plugins.TwinParticles.CheckEngine.Search.Label")</label>
                    <input id="ce-sticky-search-input"
                           class="ce-search__input"
                           name="rawText"
                           type="search"
                           autocomplete="off"
                           enterkeyhint="search"
                           placeholder="@T("Plugins.TwinParticles.CheckEngine.Search.Placeholder")"
                           aria-describedby="ce-search-hint"
                           aria-controls="ce-search-results"
                           aria-expanded="false" />
                </div>

                <label class="ce-toggle" for="ce-widen-fitment">
                    <input type="checkbox" id="ce-widen-fitment" name="widenFitment" />
                    <span>@T("Plugins.TwinParticles.CheckEngine.Search.Widen")</span>
                </label>

                @if (Model.EnableSearchNaturalLanguage || Model.EnableSearchSemantic)
                {
                    <label class="ce-visually-hidden" for="ce-search-mode">@T("Plugins.TwinParticles.CheckEngine.Search.Mode")</label>
                    <select id="ce-search-mode" class="ce-select ce-search__mode" name="searchMode" aria-describedby="ce-search-hint">
                        <option value="1">@T("Plugins.TwinParticles.CheckEngine.Search.Mode.Auto")</option>
                        @if (Model.EnableSearchNaturalLanguage)
                        {
                            <option value="7">@T("Plugins.TwinParticles.CheckEngine.Search.Mode.NaturalLanguage")</option>
                        }
                        @if (Model.EnableSearchSemantic)
                        {
                            <option value="8">@T("Plugins.TwinParticles.CheckEngine.Search.Mode.Semantic")</option>
                        }
                    </select>
                }

                <button type="submit" class="ce-btn ce-btn--primary">
                    <span class="ce-btn__label">@T("Plugins.TwinParticles.CheckEngine.Search.Submit")</span>
                </button>

                <p id="ce-search-hint" class="ce-visually-hidden">@T("Plugins.TwinParticles.CheckEngine.Search.Hint")</p>

                <div id="ce-search-results" class="ce-results" role="region" aria-label="@T("Plugins.TwinParticles.CheckEngine.Search.ResultsLabel")" hidden></div>
                <p class="ce-visually-hidden" id="ce-search-status" role="status" aria-live="polite"></p>
            </form>
        </div>

        <div id="ce-vin-disambiguation"
             class="ce-modal"
             hidden
             role="dialog"
             aria-modal="true"
             aria-labelledby="ce-vin-disambiguation-title">
            <button type="button" class="ce-modal__backdrop" data-ce-vin-dismiss tabindex="-1" aria-hidden="true"></button>
            <div class="ce-modal__panel" role="document">
                <h2 id="ce-vin-disambiguation-title" class="ce-modal__title">@T("Plugins.TwinParticles.CheckEngine.Garage.VinDisambiguation.Title")</h2>
                <p class="ce-modal__lead">@T("Plugins.TwinParticles.CheckEngine.Garage.VinDisambiguation.Lead")</p>
                <ul id="ce-vin-disambiguation-list" class="ce-modal__options" role="listbox"></ul>
                <div class="ce-modal__actions">
                    <button type="button" class="ce-btn ce-btn--quiet" data-ce-vin-dismiss>@T("Plugins.TwinParticles.CheckEngine.Garage.VinDisambiguation.Cancel")</button>
                </div>
            </div>
        </div>

        @* Localised copy for the client script, so no user-facing string is hardcoded in JS. *@
        <script type="application/json" id="ce-i18n">
            {
                "garageLabel": "@T("Plugins.TwinParticles.CheckEngine.Garage.Label")",
                "garageSelect": "@T("Plugins.TwinParticles.CheckEngine.Garage.SelectVehicle")",
                "garageEmpty": "@T("Plugins.TwinParticles.CheckEngine.Garage.Empty")",
                "garageAdd": "@T("Plugins.TwinParticles.CheckEngine.Garage.AddVehicle")",
                "garageVinPrompt": "@T("Plugins.TwinParticles.CheckEngine.Garage.VinPrompt")",
                "garageAddFailed": "@T("Plugins.TwinParticles.CheckEngine.Garage.AddFailed")",
                "garageVinDisambiguationTitle": "@T("Plugins.TwinParticles.CheckEngine.Garage.VinDisambiguation.Title")",
                "garageVinDisambiguationLead": "@T("Plugins.TwinParticles.CheckEngine.Garage.VinDisambiguation.Lead")",
                "garageVinDisambiguationCancel": "@T("Plugins.TwinParticles.CheckEngine.Garage.VinDisambiguation.Cancel")",
                "garageVinDisambiguationYear": "@T("Plugins.TwinParticles.CheckEngine.Garage.VinDisambiguation.Year")",
                "searchEmptyTitle": "@T("Plugins.TwinParticles.CheckEngine.Search.Empty.Title")",
                "searchEmptyHint": "@T("Plugins.TwinParticles.CheckEngine.Search.Empty.Hint")",
                "searchUnavailable": "@T("Plugins.TwinParticles.CheckEngine.Search.Unavailable")",
                "searchResultsCount": "@T("Plugins.TwinParticles.CheckEngine.Search.ResultsCount")",
                "searchMode": "@T("Plugins.TwinParticles.CheckEngine.Search.Mode")",
                "fitsLabel": "@T("Plugins.TwinParticles.CheckEngine.Fitment.Fits")",
                "fitsHint": "@T("Plugins.TwinParticles.CheckEngine.Fitment.Fits.Hint")",
                "unfitLabel": "@T("Plugins.TwinParticles.CheckEngine.Fitment.DoesNotFit")",
                "unfitHint": "@T("Plugins.TwinParticles.CheckEngine.Fitment.DoesNotFit.Hint")",
                "unknownLabel": "@T("Plugins.TwinParticles.CheckEngine.Fitment.Unknown")",
                "unknownHint": "@T("Plugins.TwinParticles.CheckEngine.Fitment.Unknown.Hint")",
                "detailLabel": "@T("Plugins.TwinParticles.CheckEngine.Fitment.NeedsDetail")",
                "detailHint": "@T("Plugins.TwinParticles.CheckEngine.Fitment.NeedsDetail.Hint")",
                "detailCta": "@T("Plugins.TwinParticles.CheckEngine.Fitment.NeedsDetail.Cta")",
                "selectLabel": "@T("Plugins.TwinParticles.CheckEngine.Fitment.SelectVehicle")",
                "selectHint": "@T("Plugins.TwinParticles.CheckEngine.Fitment.SelectVehicle.Hint")",
                "fitmentCta": "@T("Plugins.TwinParticles.CheckEngine.Fitment.SelectVehicle.Cta")",
                "facetsTitle": "@T("Plugins.TwinParticles.CheckEngine.Search.Facets.Title")",
                "facetCategory": "@T("Plugins.TwinParticles.CheckEngine.Search.Facets.Category")",
                "facetBrand": "@T("Plugins.TwinParticles.CheckEngine.Search.Facets.Brand")",
                "facetPrice": "@T("Plugins.TwinParticles.CheckEngine.Search.Facets.Price")",
                "facetFitment": "@T("Plugins.TwinParticles.CheckEngine.Search.Facets.Fitment")",
                "facetClear": "@T("Plugins.TwinParticles.CheckEngine.Search.Facets.Clear")",
                "recoveryTitle": "@T("Plugins.TwinParticles.CheckEngine.Search.Recovery.Title")",
                "suggestVehicles": "@T("Plugins.TwinParticles.CheckEngine.Search.Suggest.Vehicles")",
                "suggestOems": "@T("Plugins.TwinParticles.CheckEngine.Search.Suggest.Oems")",
                "suggestProducts": "@T("Plugins.TwinParticles.CheckEngine.Search.Suggest.Products")",
                "assistantTitle": "@T("Plugins.TwinParticles.CheckEngine.Assistant.Title")",
                "assistantPlaceholder": "@T("Plugins.TwinParticles.CheckEngine.Assistant.Placeholder")",
                "assistantSend": "@T("Plugins.TwinParticles.CheckEngine.Assistant.Send")",
                "assistantUnavailable": "@T("Plugins.TwinParticles.CheckEngine.Assistant.Unavailable")",
                "assistantOpen": "@T("Plugins.TwinParticles.CheckEngine.Assistant.Open")",
                "recommendTitle": "@T("Plugins.TwinParticles.CheckEngine.Recommend.Title")",
                "recommendUnscopedTitle": "@T("Plugins.TwinParticles.CheckEngine.Recommend.UnscopedTitle")",
                "recommendFitmentBadge": "@T("Plugins.TwinParticles.CheckEngine.Recommend.FitmentBadge")"
            }
        </script>

        @if (Model.EnableCustomerAssistant)
        {
        <div class="ce-assistant" data-ce-theme="assistant">
            <button type="button" class="ce-assistant__toggle" id="ce-assistant-toggle" aria-expanded="false" aria-controls="ce-assistant-panel">
                @T("Plugins.TwinParticles.CheckEngine.Assistant.Open")
            </button>
            <div id="ce-assistant-panel" class="ce-assistant__panel" hidden>
                <h2 class="ce-assistant__title">@T("Plugins.TwinParticles.CheckEngine.Assistant.Title")</h2>
                <div id="ce-assistant-log" class="ce-assistant__log" role="log" aria-live="polite"></div>
                <form id="ce-assistant-form" class="ce-assistant__form">
                    <label class="ce-visually-hidden" for="ce-assistant-input">@T("Plugins.TwinParticles.CheckEngine.Assistant.Placeholder")</label>
                    <input id="ce-assistant-input" class="ce-assistant__input" type="text" autocomplete="off" placeholder="@T("Plugins.TwinParticles.CheckEngine.Assistant.Placeholder")" />
                    <button type="submit" class="ce-btn ce-btn--primary">@T("Plugins.TwinParticles.CheckEngine.Assistant.Send")</button>
                </form>
            </div>
        </div>
        }
    </div>
}
else if (zone == "productdetails_top")
{
    @* Fitment band: colour + icon + text, never a speculative "Fits". Starts in the honest unknown state. *@
    <section class="ce-root ce-fitment"
             data-ce-theme="fitment-band"
             data-ce-fit="select"
             data-ce-product-id="@(Model.ProductId > 0 ? Model.ProductId.ToString() : string.Empty)"
             aria-live="polite">
        <svg class="ce-icon ce-fitment__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true" focusable="false">
            <circle cx="12" cy="12" r="9" />
            <path d="M12 8v4" stroke-linecap="round" />
            <path d="M12 16h.01" stroke-linecap="round" />
        </svg>
        <span class="ce-fitment__text">
            <span class="ce-fitment__status">@T("Plugins.TwinParticles.CheckEngine.Fitment.SelectVehicle")</span>
            <span class="ce-fitment__detail">@T("Plugins.TwinParticles.CheckEngine.Fitment.SelectVehicle.Hint")</span>
        </span>
    </section>
    @if (Model.EnableRecommendations)
    {
        <aside class="ce-root ce-recommend" data-ce-theme="recommendations" data-ce-product-id="@(Model.ProductId > 0 ? Model.ProductId.ToString() : string.Empty)" data-ce-enable-recommendations="true" hidden>
            <h2 class="ce-recommend__title">@T("Plugins.TwinParticles.CheckEngine.Recommend.Title")</h2>
            <ul id="ce-recommend-list" class="ce-recommend__list"></ul>
        </aside>
    }
}
else if (zone == "home_page_top")
{
    <section class="ce-root ce-hero" data-ce-theme="landing-template">
        <div class="ce-hero__inner">
            <span class="ce-hero__eyebrow">@T("Plugins.TwinParticles.CheckEngine.Hero.Eyebrow")</span>
            <h1 class="ce-hero__title">@T("Plugins.TwinParticles.CheckEngine.Hero.Title")</h1>
            <p class="ce-hero__lead">@T("Plugins.TwinParticles.CheckEngine.Hero.Lead")</p>
            <div class="ce-hero__cta">
                <button type="button" class="ce-btn ce-btn--primary" data-ce-action="focus-search">
                    @T("Plugins.TwinParticles.CheckEngine.Hero.PrimaryCta")
                </button>
                <button type="button" class="ce-btn ce-btn--quiet" data-ce-action="add-vehicle">
                    @T("Plugins.TwinParticles.CheckEngine.Hero.SecondaryCta")
                </button>
            </div>
        </div>
    </section>
}
