@model SeoLandingPageModel
@using System.Net

@{
    Layout = "_ColumnsOne";

    NopHtml.AddTitleParts(Model.Title);
    NopHtml.AddCanonicalUrlParts(Model.CanonicalUrl, withQueryString: false);
    NopHtml.AddHeadCustomParts($"<link rel=\"alternate\" hreflang=\"en\" href=\"{WebUtility.HtmlEncode(Model.HreflangUrlEn)}\" />");
    NopHtml.AddHeadCustomParts($"<link rel=\"alternate\" hreflang=\"ar\" href=\"{WebUtility.HtmlEncode(Model.HreflangUrlAr)}\" />");
    NopHtml.AddHeadCustomParts($"<link rel=\"alternate\" hreflang=\"x-default\" href=\"{WebUtility.HtmlEncode(Model.HreflangUrlEn)}\" />");

    if (!Model.IsIndexable)
        NopHtml.AddHeadCustomParts("<meta name=\"robots\" content=\"noindex, follow\" />");

    if (!string.IsNullOrWhiteSpace(Model.StructuredDataJsonLd))
        NopHtml.AddJsonLdParts(Model.StructuredDataJsonLd);
}

<div class="page category-page ce-root ce-seo-landing ce-landing" data-ce-theme="landing-template">
    <header class="ce-landing__hero">
        <h1>@Model.Heading</h1>
        <p class="ce-landing__lead">@Model.Description</p>
    </header>
    <div class="page-body">
        @if (Model.Products.Count > 0)
        {
            <div class="product-grid">
                <div class="item-grid">
                    @foreach (var product in Model.Products)
                    {
                        <div class="item-box">
                            <div class="product-item ce-product-tile" data-productid="@product.Id">
                                <div class="details">
                                    <h2 class="product-title">
                                        <a href="@product.Url">@product.Name</a>
                                    </h2>
                                    <p class="ce-product-tile__aftermarket">@T("Plugins.TwinParticles.CheckEngine.Theme.Aftermarket")</p>
                                    <div class="description">
                                        @T("Plugins.TwinParticles.CheckEngine.Theme.Landing.VerifiedFit")
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
        else
        {
            <div class="no-result">
                @T("Plugins.TwinParticles.CheckEngine.Theme.Landing.Empty")
            </div>
        }
    </div>
</div>
