@inject Nop.Core.IWorkContext workContext
@{
    Layout = "_ColumnsOne";
    ViewBag.Title = T("Plugins.TwinParticles.CheckEngine.Marketplace.Dashboard").Text;
    var language = await workContext.GetWorkingLanguageAsync();
    var isRtl = language.Rtl;
    await Html.RenderPartialAsync("~/Plugins/TwinParticles.CheckEngine/Views/Shared/_MarketplaceAssets.cshtml");
}

<div class="page vendor-dashboard-page ce-root ce-marketplace" dir="@(isRtl ? "rtl" : "ltr")" data-ce-page="dashboard">
    <div class="page-title">
        <h1>@T("Plugins.TwinParticles.CheckEngine.Marketplace.Dashboard")</h1>
    </div>
    <div class="page-body">
        @Html.AntiForgeryToken()

        <section class="ce-hero" aria-labelledby="ce-dashboard-hero-title">
            <div class="ce-hero__inner">
                <span class="ce-hero__eyebrow">@T("Plugins.TwinParticles.CheckEngine.Marketplace.Dashboard.Eyebrow")</span>
                <h2 id="ce-dashboard-hero-title" class="ce-hero__title">@T("Plugins.TwinParticles.CheckEngine.Marketplace.Dashboard.Hero")</h2>
                <p class="ce-hero__lead">@T("Plugins.TwinParticles.CheckEngine.Marketplace.Dashboard.Hint")</p>
            </div>
        </section>

        <div class="ce-mp-alert ce-mp-alert--info" data-ce-dashboard-alert hidden role="status"></div>

        <div class="ce-mp-stat-grid" data-ce-stat-grid>
            <p class="ce-mp-loading">@T("Plugins.TwinParticles.CheckEngine.Marketplace.Dashboard.Loading")</p>
        </div>

        <nav class="ce-mp-tabs" role="tablist" aria-label="@T("Plugins.TwinParticles.CheckEngine.Marketplace.Dashboard.Tabs")">
            <button type="button" class="ce-mp-tab" role="tab" data-ce-tab="overview" aria-selected="true">@T("Plugins.TwinParticles.CheckEngine.Marketplace.Dashboard.Tab.Overview")</button>
            <button type="button" class="ce-mp-tab" role="tab" data-ce-tab="inventory" aria-selected="false">@T("Plugins.TwinParticles.CheckEngine.Marketplace.Inventory")</button>
            <button type="button" class="ce-mp-tab" role="tab" data-ce-tab="fitment" aria-selected="false">@T("Plugins.TwinParticles.CheckEngine.Marketplace.Fitment.Proposals")</button>
            <button type="button" class="ce-mp-tab" role="tab" data-ce-tab="orders" aria-selected="false">@T("Plugins.TwinParticles.CheckEngine.Marketplace.Dashboard.Orders")</button>
            <button type="button" class="ce-mp-tab" role="tab" data-ce-tab="catalog" aria-selected="false">@T("Plugins.TwinParticles.CheckEngine.Marketplace.Dashboard.Catalog")</button>
            <button type="button" class="ce-mp-tab" role="tab" data-ce-tab="statements" aria-selected="false">@T("Plugins.TwinParticles.CheckEngine.Marketplace.Statements")</button>
        </nav>

        <section class="ce-mp-panel" data-ce-tabpanel="overview" role="tabpanel">
            <h2 class="ce-mp-panel__title">@T("Plugins.TwinParticles.CheckEngine.Marketplace.Scorecard")</h2>
            <p class="ce-mp-panel__lead">@T("Plugins.TwinParticles.CheckEngine.Marketplace.Scorecard.Hint")</p>
            <div class="ce-mp-metrics" data-ce-scorecard></div>
        </section>

        <section class="ce-mp-panel" data-ce-tabpanel="inventory" role="tabpanel" hidden>
            <h2 class="ce-mp-panel__title">@T("Plugins.TwinParticles.CheckEngine.Marketplace.Inventory")</h2>
            <p class="ce-mp-panel__lead">@T("Plugins.TwinParticles.CheckEngine.Marketplace.Inventory.Hint")</p>
            <div class="ce-mp-table-wrap">
                <table class="ce-mp-table" id="ce-vendor-inventory">
                    <thead>
                        <tr>
                            <th>@T("Plugins.TwinParticles.CheckEngine.Marketplace.Inventory.Product")</th>
                            <th>@T("Plugins.TwinParticles.CheckEngine.Marketplace.Inventory.Stock")</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody data-ce-inventory-body>
                        <tr><td colspan="3" class="ce-mp-loading">@T("Plugins.TwinParticles.CheckEngine.Marketplace.Dashboard.Loading")</td></tr>
                    </tbody>
                </table>
            </div>
        </section>

        <section class="ce-mp-panel" data-ce-tabpanel="fitment" role="tabpanel" hidden>
            <h2 class="ce-mp-panel__title">@T("Plugins.TwinParticles.CheckEngine.Marketplace.Fitment.Proposals")</h2>
            <p class="ce-mp-panel__lead">@T("Plugins.TwinParticles.CheckEngine.Marketplace.Fitment.Hint")</p>
            <div class="ce-mp-toolbar">
                <div class="ce-mp-field">
                    <label for="ce-fitment-product">@T("Plugins.TwinParticles.CheckEngine.Marketplace.Fitment.ProductId")</label>
                    <input id="ce-fitment-product" class="ce-mp-input ce-code" type="number" min="1" />
                </div>
                <div class="ce-mp-field">
                    <label for="ce-fitment-vehicle">@T("Plugins.TwinParticles.CheckEngine.Marketplace.Fitment.VehicleConfigId")</label>
                    <input id="ce-fitment-vehicle" class="ce-mp-input ce-code" type="number" min="1" />
                </div>
                <button type="button" class="ce-btn ce-btn--primary" data-ce-fitment-submit>@T("Plugins.TwinParticles.CheckEngine.Marketplace.Fitment.Submit")</button>
            </div>
            <div class="ce-mp-table-wrap">
                <table class="ce-mp-table">
                    <thead>
                        <tr>
                            <th>@T("Plugins.TwinParticles.CheckEngine.Marketplace.Fitment.ClaimId")</th>
                            <th>@T("Plugins.TwinParticles.CheckEngine.Marketplace.Fitment.ProductId")</th>
                            <th>@T("Plugins.TwinParticles.CheckEngine.Marketplace.Fitment.VehicleConfigId")</th>
                            <th>@T("Plugins.TwinParticles.CheckEngine.Marketplace.Fitment.Status")</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody data-ce-fitment-body></tbody>
                </table>
            </div>
        </section>

        <section class="ce-mp-panel" data-ce-tabpanel="orders" role="tabpanel" hidden>
            <h2 class="ce-mp-panel__title">@T("Plugins.TwinParticles.CheckEngine.Marketplace.Dashboard.Orders")</h2>
            <p class="ce-mp-panel__lead">@T("Plugins.TwinParticles.CheckEngine.Marketplace.Dashboard.Orders.Hint")</p>
            <div class="ce-mp-table-wrap">
                <table class="ce-mp-table">
                    <thead>
                        <tr>
                            <th>@T("Plugins.TwinParticles.CheckEngine.Marketplace.Dashboard.OrderId")</th>
                            <th>@T("Plugins.TwinParticles.CheckEngine.Marketplace.Dashboard.Customers")</th>
                            <th>@T("Plugins.TwinParticles.CheckEngine.Marketplace.Dashboard.OrderTotal")</th>
                        </tr>
                    </thead>
                    <tbody data-ce-orders-body></tbody>
                </table>
            </div>
        </section>

        <section class="ce-mp-panel" data-ce-tabpanel="catalog" role="tabpanel" hidden>
            <h2 class="ce-mp-panel__title">@T("Plugins.TwinParticles.CheckEngine.Marketplace.Dashboard.Catalog")</h2>
            <p class="ce-mp-panel__lead">@T("Plugins.TwinParticles.CheckEngine.Marketplace.Dashboard.Catalog.Hint")</p>
            <div class="ce-mp-table-wrap">
                <table class="ce-mp-table">
                    <thead>
                        <tr>
                            <th>@T("Plugins.TwinParticles.CheckEngine.Marketplace.Inventory.Product")</th>
                        </tr>
                    </thead>
                    <tbody data-ce-catalog-body></tbody>
                </table>
            </div>
        </section>

        <section class="ce-mp-panel" data-ce-tabpanel="statements" role="tabpanel" hidden>
            <h2 class="ce-mp-panel__title">@T("Plugins.TwinParticles.CheckEngine.Marketplace.Statements")</h2>
            <p class="ce-mp-panel__lead">@T("Plugins.TwinParticles.CheckEngine.Marketplace.Statements.Hint")</p>
            <div data-ce-statements>
                <p class="ce-mp-empty">@T("Plugins.TwinParticles.CheckEngine.Marketplace.Statements.Pending")</p>
            </div>
        </section>

        <script type="application/json" data-ce-i18n>
            {
                "products": "@JavaScriptEncoder.Default.Encode(T("Plugins.TwinParticles.CheckEngine.Marketplace.Dashboard.Products").Text)",
                "stockUnits": "@JavaScriptEncoder.Default.Encode(T("Plugins.TwinParticles.CheckEngine.Marketplace.Dashboard.StockUnits").Text)",
                "orders": "@JavaScriptEncoder.Default.Encode(T("Plugins.TwinParticles.CheckEngine.Marketplace.Dashboard.Orders").Text)",
                "customers": "@JavaScriptEncoder.Default.Encode(T("Plugins.TwinParticles.CheckEngine.Marketplace.Dashboard.Customers").Text)",
                "lowStock": "@JavaScriptEncoder.Default.Encode(T("Plugins.TwinParticles.CheckEngine.Marketplace.Dashboard.LowStock").Text)",
                "fillRate": "@JavaScriptEncoder.Default.Encode(T("Plugins.TwinParticles.CheckEngine.Marketplace.Scorecard.FillRate").Text)",
                "cancelRate": "@JavaScriptEncoder.Default.Encode(T("Plugins.TwinParticles.CheckEngine.Marketplace.Scorecard.CancelRate").Text)",
                "claimReject": "@JavaScriptEncoder.Default.Encode(T("Plugins.TwinParticles.CheckEngine.Marketplace.Scorecard.ClaimRejectRate").Text)",
                "onTime": "@JavaScriptEncoder.Default.Encode(T("Plugins.TwinParticles.CheckEngine.Marketplace.Scorecard.OnTimeShipment").Text)",
                "save": "@JavaScriptEncoder.Default.Encode(T("Plugins.TwinParticles.CheckEngine.Marketplace.Inventory.Save").Text)",
                "saved": "@JavaScriptEncoder.Default.Encode(T("Plugins.TwinParticles.CheckEngine.Marketplace.Inventory.Saved").Text)",
                "revoke": "@JavaScriptEncoder.Default.Encode(T("Plugins.TwinParticles.CheckEngine.Marketplace.Fitment.Revoke").Text)",
                "statementsPending": "@JavaScriptEncoder.Default.Encode(T("Plugins.TwinParticles.CheckEngine.Marketplace.Statements.Pending").Text)",
                "netPayout": "@JavaScriptEncoder.Default.Encode(T("Plugins.TwinParticles.CheckEngine.Marketplace.Statements.NetPayout").Text)",
                "emptyInventory": "@JavaScriptEncoder.Default.Encode(T("Plugins.TwinParticles.CheckEngine.Marketplace.Inventory.Empty").Text)",
                "emptyFitment": "@JavaScriptEncoder.Default.Encode(T("Plugins.TwinParticles.CheckEngine.Marketplace.Fitment.Empty").Text)",
                "emptyOrders": "@JavaScriptEncoder.Default.Encode(T("Plugins.TwinParticles.CheckEngine.Marketplace.Dashboard.Orders.Empty").Text)",
                "emptyCatalog": "@JavaScriptEncoder.Default.Encode(T("Plugins.TwinParticles.CheckEngine.Marketplace.Dashboard.Catalog.Empty").Text)"
            }
        </script>
    </div>
</div>
