FROM mcr.microsoft.com/dotnet/sdk:9.0-bookworm-slim

WORKDIR /src
COPY . .
RUN dotnet restore src/Presentation/Nop.Web/Nop.Web.csproj

ENV ASPNETCORE_URLS=http://0.0.0.0:5000
EXPOSE 5000

CMD ["dotnet", "run", "--project", "src/Presentation/Nop.Web/Nop.Web.csproj", "--no-restore", "--urls", "http://0.0.0.0:5000"]
