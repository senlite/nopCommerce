# Copy to podman/.env — never commit.

DB_PASSWORD=change-me-db
POSTGRES_USER=nopCommerce
POSTGRES_DB=nopCommerce

# HTTPS hostname after DNS (HostGator A record → 193.123.90.97).
PUBLIC_HOST=checkengine.senlite.net

# Loopback only. Senlite uses 8000/8080; Twin Particles ERP uses 8001.
WEB_PORT=8081

# Repo root (parent of podman/). On OCI:
REPO_ROOT=/opt/checkengine/senlite-commerce
